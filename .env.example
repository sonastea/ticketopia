# Ticketopia deployment configuration for all currently implemented features.
# Copy to an uncommitted .env (do not overwrite an existing one), replace the
# placeholders, and supply values through runtime environment/secret storage.
# Never use secrets as Docker build arguments or commit a populated .env.
# Setup and rollout prerequisites: docs/deployment.md#environment-template
# The application listens on port 8080; there is no PORT environment setting.

# REQUIRED: Ticketmaster Discovery API key (https://developer.ticketmaster.com/).
TICKETMASTER_KEY=replace-with-ticketmaster-api-key
# Optional per-process 24-hour request budget; coordinate across replicas.
TICKETMASTER_DAILY_BUDGET=4500

# REQUIRED: MariaDB for accounts, preferences, sessions, API tokens, and saves.
# Provision the database/users, apply migrations, and grant runtime permissions
# BEFORE starting the application. The application never migrates at startup.
# Use the database service hostname (not localhost in an application container).
PERSISTENCE_MODE=mariadb
DB_HOST=mariadb.example.com
DB_PORT=3306
DB_NAME=ticketopia
DB_USER=ticketopia_runtime
DB_PASSWORD=replace-with-unique-runtime-password
# Production: verify the server certificate's CA and hostname. Mount the public
# PEM CA bundle at this path, readable by container UID 65532; never mount CA keys.
# Only isolated local development may use disabled with DB_TLS_CA_FILE empty.
DB_TLS_MODE=verify-full
DB_TLS_CA_FILE=/etc/ticketopia/db/ca.crt

# REQUIRED: Google Web application OAuth client; enables sign-in and private saves.
# Production requires an HTTPS origin without path, query, or credentials.
# Register EXACTLY https://YOUR_HOST/auth/google/callback with Google, replacing
# YOUR_HOST with the AUTH_BASE_URL host (including its port, if nonstandard).
# Local development may use http://localhost:8080 and its matching callback.
AUTH_ENABLED=true
AUTH_BASE_URL=https://ticketopia.example.com
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret

# Location hints: ipwho.is needs no API key. Manual/remembered cities always work.
IP_GEOLOCATION_ENABLED=true
# Comma-separated CIDRs of ONLY the actual reverse proxies connecting to the app.
# Empty ignores forwarded client-IP headers. Set this behind Coolify/ingress so
# public-IP location hints and account IP limits use the real client address.
# Example for a loopback proxy only: 127.0.0.1/32,::1/128
# Never trust 0.0.0.0/0 or ::/0. See docs/location.md#configuration.
TRUSTED_PROXY_CIDRS=

# OPTIONAL shared cache; empty uses in-memory caching (all user features work).
# Choose ONE URL/backend. Credentials in URLs are secrets; URL-encode them.
# Use reachable service hostnames, not localhost for a separate cache container.
# Redis / Valkey / DragonflyDB (production TLS):
#   rediss://default:replace-with-cache-password@cache.example.com:6379/0
# Other supported schemes: redis://, valkey://, valkeys://, dragonfly://,
# dragonflys://, dragonflydb://, dragonflydbs://, and explicit memory://.
# NATS JetStream (2.11+, enabled):
#   tls://replace-with-nats-user:replace-with-nats-password@nats.example.com:4222
#   nats:// is also supported for non-TLS local development.
# Cache failures fall back to memory; shared caches do not share request budgets.
KV_URL=
# Used only with the NATS backend; the app must be allowed to access/create it.
KV_NATS_BUCKET=ticketopia_cache
# Legacy alternative, used only when KV_URL is empty; prefer KV_URL.
# REDIS_URL=rediss://default:replace-with-cache-password@cache.example.com:6379/0

# OPTIONAL runtime database pool/timeouts; values below match application defaults.
# Pool limits are PER REPLICA; budget surge, draining, migration, and admin clients.
# Durations use Go syntax (ms, s, m, h). See docs/persistence.md for allowed ranges.
DB_MAX_OPEN=10
DB_MAX_IDLE=2
DB_CONN_LIFETIME=5m
DB_CONN_IDLE_TIME=1m
DB_DIAL_TIMEOUT=3s
DB_READ_TIMEOUT=5s
DB_WRITE_TIMEOUT=5s
DB_STARTUP_TIMEOUT=10s
DB_QUERY_TIMEOUT=3s
DB_READY_TIMEOUT=500ms

# MIGRATION JOB ONLY: put these in separate job environment/secret storage, NOT
# the app container. Use the same database/TLS settings and deployed image with
# `ticketopia migrate` before rollout, then apply/reconcile runtime table grants.
# The migration user/password must be distinct from the runtime credentials.
# Database root/admin credentials are provisioning-only; never give them to apps.
# DB_MIGRATION_USER=ticketopia_migration
# DB_MIGRATION_PASSWORD=replace-with-different-unique-migration-password
# Optional migration-job deadline (default 2m, maximum 10m):
# DB_MIGRATION_TIMEOUT=2m

# OPTIONAL source revision in startup logs; blank logs "unknown".
# Coolify supplies this automatically; otherwise use the deployed image's commit.
SOURCE_COMMIT=

# No SMTP, session-signing, or personal-API-token environment secret is needed.
# Session/API tokens are generated by the app and stored as hashes in MariaDB.
# Reminders, digests, and community participation are planned, not deployable yet.
# Registry pull credentials belong to Docker/Kubernetes, not the app environment.
# Development/test-only variables are intentionally excluded.
