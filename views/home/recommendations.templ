package home

import "fmt"
import "github.com/sonastea/ticketopia/internal/models"
import "github.com/sonastea/ticketopia/internal/recommendations"
import "github.com/sonastea/ticketopia/views/layouts"
import "github.com/sonastea/ticketopia/views/components/button"
import "github.com/sonastea/ticketopia/views/components/input"
import "github.com/sonastea/ticketopia/views/components/label"
import selectcomp "github.com/sonastea/ticketopia/views/components/select"
import "github.com/sonastea/ticketopia/views/components/alert"
import "github.com/sonastea/ticketopia/views/components/empty"

templ RecommendationPanel(id string,v RecommendationView,returnURL string) {
	<div class="community-panel" data-event-recommendations={ id } data-recommendation-viewer={ v.ViewerID }>
		if !v.Enabled {
			<p class="field-note">Recommendations require accounts to be enabled on this server.</p>
		} else {
			if v.Error != "" {
				<p class="field-note" role="status">{ v.Error }</p>
			} else if !v.SignedIn {
				<div class="composer-card composer-invite">
					@ComposerBadge("community")
					<p class="composer-prompt"><strong>Recommend this event</strong><span>Recommendations are public, with your display name and profile link.</span></p>
					@button.Button(button.Props{Href:signInURL(recommendationSignInReturn(id, returnURL)),Variant:button.VariantOutline,Class:"action action-secondary"}) {
						Sign in to recommend
					}
				</div>
			} else {
				<details class="composer-card" data-recommendation-editor open?={ v.Open }>
					<summary aria-labelledby={ "recommend-composer-title-" + id } aria-describedby={ "recommend-composer-note-" + id }>
						@ComposerBadge("community")
						<span class="composer-prompt">
							if v.Own != nil {
								<strong id={ "recommend-composer-title-" + id }>Edit your recommendation</strong><span id={ "recommend-composer-note-" + id }>Change your reason or withdraw it.</span>
							} else {
								<strong id={ "recommend-composer-title-" + id }>Recommend this event</strong><span id={ "recommend-composer-note-" + id }>Tell others why it's worth going. A reason is optional.</span>
							}
						</span>
						@layouts.IconClass("chevron", "icon composer-chevron")
					</summary>
					<form action={ recommendationAction(id) } method="post" class="account-form composer-form" data-recommendation-form data-recommendation-id={ id } data-sign-in-url={ signInURL(recommendationSignInReturn(id, returnURL)) }>
						<input type="hidden" name="csrf_token" value={ v.CSRF }/>
						<input type="hidden" name="return_to" value={ returnURL }/>
						<label class="field">Why do you recommend it? <span>(optional, up to 500 characters)</span>
							<textarea name="reason" rows="3" maxlength="500" data-recommendation-reason autofocus?={ v.Open }>{ v.reason() }</textarea>
						</label>
						<p class="field-note composer-audience">Your reason, display name and profile link will be public on this event, in Community and on your profile; live activity shows your chosen first name or Someone. Interest privacy does not hide recommendations.</p>
						<div class="composer-actions">
							@button.Button(button.Props{Type:button.TypeSubmit,Class:"action composer-submit",Attributes:templ.Attributes{"name":"action","value":"set"}}) {
								if v.Own != nil {
									Save recommendation
								} else {
									Publish recommendation
								}
							}
							if v.Own != nil {
								@button.Button(button.Props{Type:button.TypeSubmit,Variant:button.VariantLink,Class:"text-link composer-utility",Attributes:templ.Attributes{"name":"action","value":"remove","formnovalidate":true}}) {
									Withdraw recommendation
								}
							}
						</div>
						<p class="field-note" role="alert" data-recommendation-error hidden></p>
					</form>
				</details>
			}
			<div class="note-list-head">
				<h3>Public recommendations</h3>
				if v.List.Count != nil {
					<p class="list-meta" data-live-total={ id } data-live-hide-zero hidden?={ *v.List.Count == 0 }><strong>{ fmt.Sprint(*v.List.Count) }</strong> { recommendationCountLabel(*v.List.Count) }</p>
				}
			</div>
			if v.ListError != "" {
				<p class="field-note" role="status">{ v.ListError }</p>
			} else {
				@RecommendationList(v.List,listContext{Place:inEvent,EventID:id,ViewerID:v.ViewerID},returnURL)
				if v.List.NextCursor != nil {
					<a href={ templ.URL(recommendationListURL(id,returnOrigin(returnURL))) } class="text-link">See all recommendations</a>
				}
			}
		}
	</div>
}

// ComposerBadge marks a community composer or sign-in invitation with the
// icon of what it publishes.
templ ComposerBadge(icon string) {
	<span class="composer-badge" aria-hidden="true">
		@layouts.Icon(icon)
	</span>
}

templ RecommendationList(list recommendations.List,c listContext,returnURL string) {
	if len(list.Items)==0 {
		if c.FirstPage!="" {
			<p class="field-note">No more recommendations on this page.</p>
			<a href={ templ.URL(c.FirstPage) } class="text-link">Back to the newest recommendations</a>
		} else if c.Place==onProfile {
			<p class="field-note">No public recommendations yet.</p>
		} else {
			<p data-live-empty={ c.EventID }>No one has recommended this event yet. If it's worth going to, be the first to say why.</p>
		}
	} else if !c.showsEvent() {
		// On the event itself, each recommendation is a quote card: the
		// person's words first, then who said it and when. The viewer's own
		// card is marked and framed.
		<ul class="recommendation-list rec-cards">
			for _,item := range list.Items {
				<li class={ "rec-card", templ.KV("rec-card-own", c.ViewerID != "" && item.Profile.ID == c.ViewerID) }>
					if item.Reason!="" {
						<blockquote class="rec-quote recommendation-reason">{ item.Reason }</blockquote>
					} else {
						<p class="rec-quote rec-quote-empty">Recommends this event</p>
					}
					<div class="rec-byline">
						@Avatar(initials(item.Profile.DisplayName))
						<p class="rec-who recommendation-attribution">
							<a href={ templ.URL("/users/"+item.Profile.ID) } class="note-author"><span>{ item.Profile.DisplayName }</span></a>
							if c.ViewerID != "" && item.Profile.ID == c.ViewerID {
								<span class="note-tag">You</span>
							}
							@RecommendationVia(item)
							<span class="note-meta">@layouts.StampDate(item.RecommendedAt)
								if !item.UpdatedAt.Equal(item.RecommendedAt) {
									<span> · Edited</span>
								}
							</span>
						</p>
					</div>
				</li>
			}
		</ul>
	} else {
		<ul class="recommendation-list">
			for _,item := range list.Items {
				<li class={ templ.KV("recommendation-event",c.showsEvent()) }>
					if c.showsEvent() {
						@CollectionEventArt(item.Event,returnURL)
					}
					<div class="recommendation-copy">
						if c.showsEvent() {
							@CollectionEventHeading(item.Event,returnURL)
							@CollectionEventFreshness(item.Meta)
							@EventFacts(item.Event)
						}
						<p class="recommendation-attribution">
							<a href={ templ.URL("/users/"+item.Profile.ID) } class="text-link">{ item.Profile.DisplayName }</a> recommends this event
							@RecommendationVia(item)
						</p>
						if item.Reason!="" {
							<p class="recommendation-reason">{ item.Reason }</p>
						}
						<p class="field-note">{ "Published " }@layouts.StampDate(item.RecommendedAt)
							if !item.UpdatedAt.Equal(item.RecommendedAt) {
								<span> · Edited</span>
							}
						</p>
						if c.showsEvent() {
							<a href={ templ.URL(eventURL(item.Event.ID,"community",returnURL)) } class="text-link">Recommendations</a>
						}
					</div>
				</li>
			}
		</ul>
	}
}

// RecommendationVia names the connected app an agent published through, or
// whose drafted reason the person published. The name is the app's own claim,
// so the verified host is shown visibly beside it; both stay plain text,
// never a link.
templ RecommendationVia(item recommendations.Item) {
	if item.Via != "" {
		{ " " }<span class="recommendation-via">{ viaLabel(item) }</span>
	}
}

// Happening Now lives inside Community rather than in main navigation: during
// the pilot its 10-minute window is usually empty.
templ CommunityNav(current string) {
	<nav class="section-nav" aria-label="Community collections">
		<a href="/community" aria-current={ layouts.CurrentPage(current == "recommendations") } class="text-link">
			Recommendations
			@tabMark(current == "recommendations")
		</a>
		<a href="/community/discussions" aria-current={ layouts.CurrentPage(current == "conversations") } class="text-link">
			Conversations
			@tabMark(current == "conversations")
		</a>
		if layouts.LiveActivityEnabled(ctx) {
			<a href="/happening-now" aria-current={ layouts.CurrentPage(current == "happening-now") } class="text-link">
				Happening Now
				@tabMark(current == "happening-now")
			</a>
		}
	</nav>
}

templ Community(p CommunityPage) {
	@layouts.App("community","Community recommendations") {
		<main id="main" class="destination-page community-page">
			@layouts.PageHeader("Recommended by the community", "Each event appears once, with the people and reasons behind its public recommendations.") {
				@CommunityNav("recommendations")
			}
			if !p.Enabled {
				<p>Community recommendations require accounts to be enabled on this server. You can still discover events.</p>
				<a href="/" class="text-link">Discover events</a>
			} else {
				@CommunityFilters(CommunityFilterBar{Action:"/community",Prefix:"community",Label:"Filter recommendations",City:p.Filters.City,Country:p.Filters.Country,CategoryID:p.Filters.CategoryID,Categories:p.Categories})
				if p.CategoriesUnavailable {
					<p class="field-note">Category options couldn't refresh. Recommendations and your selected filter are still available.</p>
				}
				if p.Error!="" {
					@alert.Alert(alert.Props{Class:"feedback error-state",Variant:alert.VariantDestructive}) {
						<h2>Recommendations couldn't load</h2><p>{ p.Error }</p><a href="/community" class="text-link">Reset filters and retry</a>
					}
				} else {
					<section class="community-results" aria-labelledby="community-results-heading">
						<div class="results-heading"><h2 id="community-results-heading">Recommended events</h2><span class="sort-label">First recommended, newest first</span></div>
						@CommunityRecommendationList(p.List,p.ReturnURL,communityContext(p.ReturnURL,p.Filters.City,p.Filters.Country,p.Filters.CategoryID))
						if p.List.NextCursor != nil {
							@button.Button(button.Props{Href:CollectionNextURL(p.ReturnURL,p.List.NextCursor),Variant:button.VariantOutline,Class:"action action-secondary"}) {
								More recommendations
							}
						}
						<p class="participation-note">Recommendations don't confirm attendance, ticket ownership, or current ticket availability.</p>
					</section>
				}
			}
		</main>
	}
}

// Community collections are mostly empty during the pilot, so each empty
// state is a large display line leading straight to the next useful action.
templ CommunityEmpty(title, body, href, action string) {
	@empty.Empty(empty.Props{Class:"feedback empty-state empty-moment"}) {
		<h3 class="empty-display">{ title }</h3>
		if body!="" {
			<p>{ body }</p>
		}
		@button.Button(button.Props{Href:href,Class:"action"}) {
			{ action }
		}
	}
}

// One compact bar of filters; labels stay available to assistive technology
// while placeholders and the select's own option name each field visually.
templ CommunityFilters(f CommunityFilterBar) {
	<form action={ templ.SafeURL(f.Action) } method="get" class="filter-bar community-filters" aria-label={ f.Label }>
		@label.Label(label.Props{For:f.Prefix+"-city",Class:"sr-only"}) {
			City (optional)
		}
		@input.Input(input.Props{ID:f.Prefix+"-city",Name:"city",Value:f.City,Placeholder:"Any city",Attributes:templ.Attributes{"maxlength":"120","autocomplete":"address-level2"}})
		@label.Label(label.Props{For:f.Prefix+"-country",Class:"sr-only"}) {
			Country (optional, 2-letter code)
		}
		@input.Input(input.Props{ID:f.Prefix+"-country",Name:"country",Value:f.Country,Placeholder:"Country",Class:"filter-bar-country",Attributes:templ.Attributes{"maxlength":"2","pattern":"[A-Za-z]{2}","title":"Two-letter country code, such as US","autocomplete":"country","autocapitalize":"characters"}})
		@label.Label(label.Props{For:f.Prefix+"-category",Class:"sr-only"}) {
			Category
		}
		@selectcomp.Native(selectcomp.NativeProps{ID:f.Prefix+"-category",Name:"category_id"}) {
			<option value="all">All categories</option>
			if f.CategoryID!="" && !f.hasCategory() {
				<option value={ f.CategoryID } selected>{ f.CategoryID }</option>
			}
			for _,category := range f.Categories {
				<option value={ category.ID } selected?={ category.ID==f.CategoryID }>{ category.Name }</option>
			}
		}
		@button.Button(button.Props{Type:button.TypeSubmit,Class:"action action-secondary"}) {
			Apply
		}
	</form>
}

templ Avatar(text string) {
	<span class="avatar" aria-hidden="true">{ text }</span>
}

templ CommunityRecommendationList(feed recommendations.Feed,returnURL string,c listContext) {
	if len(feed.Items)==0 {
		if c.FirstPage!="" {
			@CommunityEmpty("No more recommendations on this page.","",c.FirstPage,"Back to the newest recommendations")
		} else if c.Filtered {
			@CommunityEmpty("No recommended events match these filters.","Try another city or category, or clear the filters.","/community","Reset filters")
		} else {
			@CommunityEmpty("No recommendations yet.","When someone recommends an event, it appears here with their reasons. Found something worth going to? Open it and choose Recommend.","/","Find an event to recommend")
		}
	} else {
		// Last-known details are explained once for the list; each affected
		// card keeps a short marker.
		if anyStale(feed) {
			<p class="freshness-notice-line">Some events show last-known details, not live availability. Check the ticket page before you buy.</p>
		}
		<ul class="recommendation-list community-cards">
			for _,group:=range feed.Items {
				<li class="recommendation-event">
					@CollectionEventArt(group.Event,returnURL)
					<div class="recommendation-copy">
						@CollectionEventHeading(group.Event,returnURL)
						<ul class="community-recommenders">
							for _,item:=range group.Recommendations {
								<li>
									<figure class="pull-quote">
										if item.Reason!="" {
											<blockquote class="recommendation-reason">{ item.Reason }</blockquote>
										}
										<figcaption class="byline">
											@Avatar(initials(item.Profile.DisplayName))
											<p class="recommendation-attribution">
												<a href={ templ.URL("/users/"+item.Profile.ID) } class="text-link">{ item.Profile.DisplayName }</a> <span>recommends this event</span>
												@RecommendationVia(item)
											</p>
										</figcaption>
									</figure>
								</li>
							}
						</ul>
						// The caveat sits directly before the facts it qualifies.
						if group.Meta.Stale {
							<p class="event-last-known">Price and sale status last known { freshnessLabel(group.Meta.DataAsOf) }</p>
						}
						@EventFacts(group.Event)
						<p class="list-meta"><span data-live-total={ group.Event.ID }><strong>{ fmt.Sprint(group.Count) }</strong> { recommendationCountLabel(group.Count) }</span>{ " · first recommended " }@layouts.StampDate(group.FirstRecommendedAt)</p>
						// Two places: the event's own Recommendations section, and the
						// full paginated list for this event.
						<div class="card-actions">
							<a href={ templ.URL(eventURL(group.Event.ID,"community",returnURL)) } class="card-action-primary">
								@layouts.Icon("community")
								<span>Recommendations</span>
								@layouts.IconClass("arrow", "icon card-action-arrow")
							</a>
							<a href={ templ.URL(recommendationListURL(group.Event.ID,returnURL)) } class="card-action-secondary">
								@layouts.Icon("list")
								<span>See all<span class="sr-only">{ " recommendations for this event" }</span></span>
							</a>
						</div>
					</div>
				</li>
			}
		</ul>
	}
}

templ PublicRecommendationEvents(list recommendations.List,returnURL string,message string) {
	<section class="account-section" aria-labelledby="profile-recommendations-heading">
		<h2 id="profile-recommendations-heading">Public recommendations</h2>
		if message!="" {
			<p class="field-note" role="status">{ message }</p>
		} else {
			@RecommendationList(list,listContext{Place:onProfile,FirstPage:laterPage(returnURL,"recommendation_cursor")},returnURL)
			if list.NextCursor!=nil {
				<a href={ templ.URL(profileRecommendationNextURL(returnURL,list.NextCursor)) } class="text-link">More public recommendations</a>
			}
		}
	</section>
}

templ RecommendationFailure(id,reason,csrf,returnURL,message string,withdraw,signIn bool) {
	@layouts.App("community","Recommendation wasn't saved") {
		<main id="main" class="destination-page account-page">
			<h1>Recommendation wasn't saved</h1><p role="alert">{ message }</p>
			<form action={ recommendationAction(id) } method="post" class="account-form">
				<input type="hidden" name="csrf_token" value={ csrf }/><input type="hidden" name="return_to" value={ returnURL }/>
				<p class="field-note">Publishing makes your display name, profile link, and reason public. Saved and Interested remain separate.</p>
				<label class="field">Why do you recommend it? <span>(optional, up to 500 characters)</span><textarea name="reason" rows="4" maxlength="500">{ reason }</textarea></label>
				if csrf == "" {
					<p class="field-note">Your draft is kept above. Copy your reason before signing in or refreshing the event, then paste it into the recommendation form to retry.</p>
					if signIn {
						<a href={ templ.URL(signInURL(recommendationSignInReturn(id, returnURL))) } class="text-link">Sign in to continue</a>
					}
				} else if withdraw {
					@button.Button(button.Props{Type:button.TypeSubmit,Class:"action action-secondary",Attributes:templ.Attributes{"name":"action","value":"remove","formnovalidate":true}}) {
						Retry withdrawal
					}
				} else {
					@button.Button(button.Props{Type:button.TypeSubmit,Class:"action action-secondary",Attributes:templ.Attributes{"name":"action","value":"set"}}) {
						Retry recommendation
					}
				}
				<p class="field-note" role="alert" data-recommendation-error hidden></p>
			</form>
			<a href={ templ.URL(returnURL) } class="text-link">Back to event</a>
		</main>
	}
}

templ EventRecommendations(event models.Event,list recommendations.List,paginationURL,origin string) {
	@layouts.App("community","Recommendations for "+event.Name) {
		<main id="main" class="destination-page account-page">
			@DrilldownReturn(event.ID,"community",origin)
			<h1>Recommendations for { event.Name }</h1><p class="event-date">{ startLabel(event.Start) }</p><p class="event-venue">{ venueLabel(event) }</p>
			@RecommendationList(list,listContext{Place:inEvent,EventID:event.ID,FirstPage:laterPage(paginationURL,"cursor")},origin)
			if list.NextCursor!=nil {
				<a href={ templ.URL(CollectionNextURL(paginationURL,list.NextCursor)) } class="text-link">More recommendations</a>
			}
		</main>
	}
}
