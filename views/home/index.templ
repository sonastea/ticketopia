package home

import "fmt"
import "github.com/sonastea/ticketopia/internal/models"
import "github.com/sonastea/ticketopia/views/layouts"
import "github.com/sonastea/ticketopia/views/components/button"
import "github.com/sonastea/ticketopia/views/components/input"
import "github.com/sonastea/ticketopia/views/components/label"
import "github.com/sonastea/ticketopia/views/components/collapsible"
import selectcomp "github.com/sonastea/ticketopia/views/components/select"
import "github.com/sonastea/ticketopia/views/components/alert"
import "github.com/sonastea/ticketopia/views/components/empty"
import "github.com/sonastea/ticketopia/views/components/card"
import "github.com/sonastea/ticketopia/views/components/skeleton"

templ Index(page SearchPage) {
	@layouts.App("discover", "Discover events") {
		<main id="main" class={ "discovery-workspace", templ.KV("has-selection", page.SelectedID != "") } data-results-url={ page.ReturnURL }>
			<div class="discovery-content">
				<header class="discovery-header">
					<div class="location-bar">
						<div>
							@layouts.Icon("location")
							<strong>{ cityLabel(page) }</strong>
							if page.Filters.City == "" {
								<strong>Choose your city</strong>
							}
						</div>
						@button.Button(button.Props{Href: "#city", Variant: button.VariantLink, Class: "text-link", Attributes: templ.Attributes{"data-open-filters": true}}) {
							Change city
						}
					</div>
					if page.LocationSource == "ip" {
						<p class="location-source">Estimated from your IP address</p>
					} else if page.LocationSource == "saved" {
						<p class="location-source">Your remembered city</p>
					}
					<h1>Find your next event</h1>
					<p class="intro">Explore music, sports, arts, and more in your city.</p>
					if page.NeedsLocation && page.Error == "" {
						<p class="location-prompt">Enter a city below to see events near you. We'll remember your choice for your next visit.</p>
					}
				</header>
				@SearchControls(page)
				if page.Error != "" {
					@alert.Alert(alert.Props{Class: "feedback error-state", Variant: alert.VariantDestructive}) {
						<h2>Search couldn't finish</h2>
						<p>{ page.Error }</p>
						@button.Button(button.Props{Href: "#city", Variant: button.VariantLink, Class: "text-link", Attributes: templ.Attributes{"data-open-filters": true}}) {
							Review your filters
						}
					}
				} else if !page.NeedsLocation {
					<section aria-labelledby="results-heading">
						<div class="results-heading">
							<h2 id="results-heading">Upcoming events <span>{ resultsTitle(page.Events.Total) }</span></h2>
							<span class="sort-label">Date, soonest first</span>
						</div>
						@Freshness(page.Events.Meta)
						if len(page.Events.Items) == 0 {
							@empty.Empty(empty.Props{Class: "feedback empty-state"}) {
								<h3>No events found for these filters</h3>
								<p>Try a nearby city, a wider date range, or all categories.</p>@button.Button(button.Props{Href: "/", Variant: button.VariantLink, Class: "text-link"}) {
	Reset filters
}
							}
						} else {
							<p id="participation-note" class="participation-note">Save and Interested are not available yet.</p>
						}
						<ul id="event-list" class="event-list">
							@EventRows(page.Events.Items, page.ReturnURL, page.SelectedID)
						</ul>
						@Pagination(page)
					</section>
				} else {
					@empty.Empty(empty.Props{Class: "first-visit", Attributes: templ.Attributes{"aria-labelledby": "first-visit-heading"}}) {
						@layouts.Icon("ticket")
						<h2 id="first-visit-heading">A good night starts nearby.</h2>
						<p>Choose a city to find events, from familiar favorites to something new.</p>
					}
				}
				@SourceFooter()
			</div>
			<aside id="event-context" class="event-context" aria-label="Event preview" tabindex="-1">
				if page.SelectionError != "" {
					@PreviewError(page.SelectionError, eventURL(page.SelectedID, page.Section, page.ReturnURL), page.ReturnURL)
				} else if page.Selected != nil {
					@EventContext(EventPage{Detail: *page.Selected, Section: page.Section, ReturnURL: page.ReturnURL})
				} else {
					@EmptyContext()
				}
			</aside>
			<template id="preview-loading-template">@PreviewLoading()
</template>
			<template id="preview-error-template">@PreviewError("We couldn't load this event. Try again or open its full page.", "/", page.ReturnURL)
</template>
			<template id="preview-empty-template">@EmptyContext()
</template>
			<p id="selection-status" class="sr-only" role="status"></p>
		</main>
	}
}

templ SearchControls(page SearchPage) {
	<form action="/" method="get" class="search-form" aria-label="Search events">
		<div class="search-bar">
			@label.Label(label.Props{For: "keyword", Class: "sr-only"}) {
				Event, performer, team, or keyword
			}
			@layouts.Icon("search")
			@input.Input(input.Props{Type: "search", ID: "keyword", Name: "keyword", Value: page.Filters.Keyword, Placeholder: "Event, performer, team, or venue", Attributes: templ.Attributes{"maxlength": "120"}})
			@button.Button(button.Props{Type: button.TypeSubmit, Class: "action"}) {
				Find events
			}
		</div>
		@collapsible.Native(collapsible.Props{ID: "filters", Class: "filter-disclosure", DefaultOpen: page.NeedsLocation || page.Error != ""}) {
			@collapsible.Summary() {
				@layouts.Icon("filters")
				<span>Filters</span><span class="filter-summary">{ categoryFilterLabel(page) }<span aria-hidden="true">· </span>{ dateRangeLabel(page.Filters) }</span>@layouts.Icon("chevron")
			}
			<div class="filter-fields">
				<div class="field-grid">
					@label.Label(label.Props{For: "city", Class: "field"}) {
						City
						@input.Input(input.Props{ID: "city", Name: "city", Value: page.Filters.City, Placeholder: "e.g. Chicago", Required: page.Filters.VenueID == "", Attributes: templ.Attributes{"maxlength": "120", "autocomplete": "address-level2"}})
					}
					@label.Label(label.Props{For: "country", Class: "field"}) {
						Country code <span>(optional)</span>
						@input.Input(input.Props{ID: "country", Name: "country", Value: page.Filters.Country, Placeholder: "e.g. US, CA, GB", Attributes: templ.Attributes{"maxlength": "2", "pattern": "[A-Za-z]{2}", "autocomplete": "country"}})
					}
					@label.Label(label.Props{For: "start-date", Class: "field"}) {
						From
						@input.Input(input.Props{ID: "start-date", Name: "start_date", Type: "date", Value: page.Filters.StartDate, Required: true})
					}
					@label.Label(label.Props{For: "end-date", Class: "field"}) {
						Through
						@input.Input(input.Props{ID: "end-date", Name: "end_date", Type: "date", Value: page.Filters.EndDate, Required: true})
					}
					@label.Label(label.Props{For: "category", Class: "field field-wide"}) {
						Category
						@selectcomp.Native(selectcomp.NativeProps{ID: "category", Name: "category_id", Attributes: templ.Attributes{"aria-describedby": "genre-help"}}) {
							<option value="all" selected?={ page.Filters.CategoryID == "" }>All categories</option>
							if page.Filters.CategoryID != "" && page.category().ID == "" {
								<option value={ page.Filters.CategoryID } selected>{ page.Filters.CategoryID }</option>
							}
							for _, category := range page.Categories.Items {
								<option value={ category.ID } selected?={ category.ID == page.Filters.CategoryID }>{ category.Name }</option>
							}
						}
					}
					@label.Label(label.Props{For: "genre", Class: "field field-wide"}) {
						Genre
						@selectcomp.Native(selectcomp.NativeProps{ID: "genre", Name: "genre_id", Disabled: page.Filters.CategoryID == "", Attributes: templ.Attributes{"aria-describedby": "genre-help"}}) {
							<option value="">All genres</option>
							if page.Filters.GenreID != "" && !hasGenre(page.category().Genres, page.Filters.GenreID) {
								<option value={ page.Filters.GenreID } selected>{ page.Filters.GenreID }</option>
							}
							@GenreOptions(page.category().Genres, page.Filters.GenreID)
						}
					}
				</div>
				<input type="hidden" name="genre_category_id" value={ page.Filters.CategoryValue() }/>
				for _, category := range page.Categories.Items {
					<template data-category-genres={ category.ID }>@GenreOptions(category.Genres, "")
</template>
				}
				<p id="genre-help" class="field-note">Genres belong to a category. Changing category clears the previous genre.</p>
				<noscript><p class="field-note">Apply your category first, then choose a genre from the updated options.</p></noscript>
				if page.Filters.ArtistID != "" {
					<input type="hidden" name="artist_id" value={ page.Filters.ArtistID }/>
				}
				if page.Filters.VenueID != "" {
					<input type="hidden" name="venue_id" value={ page.Filters.VenueID }/>
				}
				if page.Filters.Limit > 0 {
					<input type="hidden" name="limit" value={ fmt.Sprint(page.Filters.Limit) }/>
				}
				if page.CategoriesUnavailable {
					<p class="field-note">Category and genre options are temporarily unavailable. You can still search by city, dates, or keyword.</p>
				} else if page.Categories.Meta.Stale {
					<p class="field-note">Showing previously collected category and genre options while Ticketmaster is unavailable.</p>
				}
				<div class="filter-actions">
					@button.Button(button.Props{Type: button.TypeSubmit, Class: "action"}) {
						Apply filters
					}
					<span id="browser-location" hidden>@button.Button(button.Props{ID: "detect-city", Variant: button.VariantLink, Class: "text-link", Attributes: templ.Attributes{"aria-describedby": "location-feedback"}}) {
	Detect my city
}
</span>
					@button.Button(button.Props{Href: "/", Variant: button.VariantLink, Class: "text-link"}) {
						Reset filters
					}
				</div>
				<p id="location-feedback" role="status" class="field-note"></p>
			</div>
		}
	</form>
}

templ GenreOptions(genres []models.Genre, selected string) {
	for _, genre := range genres {
		<option value={ genre.ID } selected?={ genre.ID == selected }>{ genre.Name }</option>
	}
}

templ EmptyContext() {
	@card.Card(card.Props{Class: "context-empty"}) {
		<h2>A closer look</h2>
		<div class="preview-placeholder" aria-hidden="true">@layouts.Icon("ticket")
</div>
		<h3>Something catch your eye?</h3>
		<p>Select an event to see its dates, venue, and ticket details here.</p>
		<div class="context-footnote"><p>Good plans start with the details.</p><p>Event conversations and recommendations are coming later.</p></div>
	}
}

templ PreviewLoading() {
	<div class="context-loading">
		<p>Loading event…</p>
		@skeleton.Skeleton(skeleton.Props{Class: "skeleton-art", Attributes: templ.Attributes{"aria-hidden": "true"}})
		@skeleton.Skeleton(skeleton.Props{Class: "skeleton-line", Attributes: templ.Attributes{"aria-hidden": "true"}})
		@skeleton.Skeleton(skeleton.Props{Class: "skeleton-line", Attributes: templ.Attributes{"aria-hidden": "true"}})
	</div>
}

templ PreviewError(message string, eventURL string, returnURL string) {
	@alert.Alert(alert.Props{Class: "context-inner feedback"}) {
		<h2>Event preview unavailable</h2>
		<p>{ message }</p>
		@button.Button(button.Props{Class: "action", Attributes: templ.Attributes{"data-preview-retry": true, "hidden": true}}) {
			Retry
		}
		@button.Button(button.Props{Href: eventURL, Variant: button.VariantLink, Class: "text-link", Attributes: templ.Attributes{"data-preview-open": true}}) {
			Open event
		}
		@button.Button(button.Props{Href: returnURL, Variant: button.VariantLink, Class: "text-link", Attributes: templ.Attributes{"data-close-context": true}}) {
			Back to results
		}
	}
}

templ SourceFooter() {
	<footer class="source-footer">Event information from Ticketmaster. Advertised prices may exclude fees. Listings do not guarantee ticket availability; check the event's ticket page for current details.</footer>
}
