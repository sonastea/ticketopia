package home

import "github.com/sonastea/ticketopia/views/layouts"

// Offline is what the service worker shows when a navigation can't reach the
// network. It must work from its one cached response, so it is a complete
// document: no stylesheet, font or script requests, and its colours repeat the
// app.css palette roles. Try again reloads whichever URL failed, because the
// worker serves this page in that URL's place.
templ Offline() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="theme-color" content="#faf9fb"/>
			<meta name="color-scheme" content="light"/>
			<meta name="robots" content="noindex"/>
			<title>You're offline · Ticketopia</title>
			<style nonce={ templ.GetNonce(ctx) }>
				:root {
					--ink: oklch(0.272162 0.015629 307.825);
					--muted: oklch(0.504217 0.021128 314.624);
					--brand: oklch(0.427958 0.080387 337.297);
					--brand-soft: oklch(0.911900 0.021106 332.882);
					--paper: oklch(0.983440 0.002834 308.429);
					--surface: oklch(1 0 none);
					--ease-out: cubic-bezier(.16, 1, .3, 1);
					color-scheme: light;
					overflow-wrap: break-word;
					-webkit-text-size-adjust: 100%;
				}
				*, *::before, *::after { box-sizing: border-box; min-inline-size: 0; }
				body {
					display: grid;
					place-items: center;
					min-block-size: 100dvh;
					margin: 0;
					padding: clamp(1rem, .17rem + 4.17vw, 2rem);
					background: var(--paper);
					color: var(--ink);
					font-family: Manrope, system-ui, sans-serif;
					line-height: 1.6;
				}
				main { display: grid; justify-items: start; gap: 1rem; max-inline-size: 28rem; }
				.brand { display: flex; align-items: center; gap: .65rem; color: var(--ink); font-size: 1.6rem; font-weight: 800; letter-spacing: -.04em; }
				.stop { color: var(--brand); }
				.icon { flex: none; inline-size: 1.125em; block-size: 1.125em; color: var(--brand); rotate: -12deg; }
				h1 { margin: 0; font-size: clamp(1.75rem, 1.5rem + .625vw, 2rem); line-height: 1.25; letter-spacing: -.035em; text-wrap: balance; }
				p { margin: 0; color: color-mix(in oklch, var(--muted), var(--brand) 12%); }
				a {
					display: inline-flex;
					align-items: center;
					min-block-size: 2.75rem;
					padding-inline: 1.25rem;
					border-radius: .5rem;
					background: var(--brand);
					color: var(--surface);
					font-weight: 700;
					text-decoration: none;
					transition: background-color 160ms var(--ease-out);
				}
				a:active { background: color-mix(in oklch, var(--brand), black 28%); }
				a:focus-visible { outline: 3px solid var(--brand); outline-offset: 4px; }
				@media (hover: hover) and (pointer: fine) {
					a:hover { background: color-mix(in oklch, var(--brand), black 18%); }
				}
				@media (forced-colors: active) {
					a { border: 1px solid ButtonText; }
				}
			</style>
		</head>
		<body>
			<main>
				<p class="brand">
					@layouts.Icon("ticket")
					<span>ticketopia<span class="stop">.</span></span>
				</p>
				<h1>You're offline</h1>
				<p>Ticketopia needs a connection to find events and load your plans. Check your connection, then try again.</p>
				<a href="">Try again</a>
			</main>
			<script nonce={ templ.GetNonce(ctx) }>
				addEventListener('online', () => location.reload());
			</script>
		</body>
	</html>
}
