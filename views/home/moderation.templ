package home

import "fmt"
import "time"
import "github.com/sonastea/ticketopia/internal/moderation"
import "github.com/sonastea/ticketopia/views/layouts"
import "github.com/sonastea/ticketopia/views/components/button"
import selectcomp "github.com/sonastea/ticketopia/views/components/select"


templ ReportConcern(p ReportPage) {
	@layouts.App("community","Report a concern privately") {
		<main id="main" class="destination-page moderation-page">
			<h1>Report a concern privately</h1>
			<p class="intro">Ask a moderator to review this contribution. Your report and identity are visible only to you and authorized moderators—not the author or the public.</p>
			if p.Post.ID!="" {
				<header class="discussion-event-heading"><h2>{ p.Post.Event.Name }</h2><p class="event-date">{ startLabel(p.Post.Event.Start) }</p><p class="event-venue">{ venueLabel(p.Post.Event) }</p></header>
				if p.Post.Removed || p.Post.Hidden {
					<p class="field-note">This contribution is no longer visible. You can still check any report you've already sent.</p>
				} else {
					<figure class="moderation-evidence">
						<figcaption><strong>Reported contribution</strong>@PostAttribution(p.Post)</figcaption>
						<blockquote class="discussion-body">{ p.Post.Body }</blockquote>
					</figure>
				}
				<a href={ templ.URL(ThreadURL(p.Post.EventID,p.Post.ThreadID,"/")) } class="text-link">Back to conversation</a>
			}
			if p.Error!="" {
				<p class="account-notice" role="alert">{ p.Error }</p>
			}
			<form action={ "/posts/"+p.PostID+"/report" } method="post" class="account-form moderation-form">
				<input type="hidden" name="csrf_token" value={ p.CSRF }/>
				<label class="field" for="report-reason"><span id="report-reason-label">Reason</span>
				@selectcomp.Native(selectcomp.NativeProps{ID:"report-reason",Name:"reason",Attributes:templ.Attributes{"required":true,"aria-labelledby":"report-reason-label"}}) {
					<option value="" selected?={ p.Reason=="" }>Choose a reason</option>
					for _,reason:=range []string{"spam","abuse","private_information","other"} {
						<option value={ reason } selected?={ reason==p.Reason }>{ reportReason(reason) }</option>
					}
				}
				</label>
				<label class="field">Additional context <span>(optional, up to 2000 characters)</span><textarea name="context" rows="4" maxlength="2000">{ p.Context }</textarea></label>
				<p class="field-note">Reports request a review; they are not downvotes and don't automatically hide content. One report per person per contribution is kept, so retrying won't create duplicates.</p>
				if p.CSRF!="" {
					@button.Button(button.Props{Type:button.TypeSubmit,Class:"action action-secondary"}) {
						Send private report
					}
				} else {
					<p class="field-note">Your context is kept above. Copy it before signing in, then return here to send your report.</p><a href={ templ.URL(signInURL("/posts/"+p.PostID+"/report")) } class="text-link">Sign in to report</a>
				}
			</form>
			<a href="/me/reports" class="text-link moderation-utility">Check your reports</a>
		</main>
	}
}

templ OutcomeSummary(o moderation.Outcome) {
	<p><strong>{ moderationAction(o.Action) }</strong>{ " · " }@layouts.Stamp(o.CreatedAt)</p>
	<p class="discussion-body">{ o.Reason }</p>
}

templ OwnModeration(p OwnModerationPage) {
	@layouts.App("profile","Your reports and moderation") {
		<main id="main" class="destination-page moderation-page">
			if p.OutcomesView {
				@layouts.AccountHeader("Your moderation outcomes", "Reasons for actions on your contributions, with a way to request another review. Reporter identities and private moderator notes are never shown here.", "outcomes", p.Navigation)
			} else {
				@layouts.AccountHeader("Your private reports", "Every report below was received. Check here for review outcomes; no email or push notifications are sent.", "reports", p.Navigation)
			}
			if p.OutcomesView {
				if len(p.Outcomes.Items)==0 {
					<div class="destination-state">
						<h2>No moderation actions on your contributions on this page.</h2>
						<p>If a moderator acts on something you posted, the decision and any option to request another review will appear here.</p>
						<a href="/me/reports" class="text-link moderation-utility">View your reports</a>
					</div>
				}
				for _,o:=range p.Outcomes.Items {
					<section class="moderation-record" aria-label="Moderation outcome">
						<h2>{ o.EventName }</h2>
						<p class="field-note">{ ternary(o.PostID==o.ThreadID,"Your question or tip","Your reply") } · { "posted " }@layouts.Stamp(o.PostCreatedAt)</p>
						@OutcomeSummary(o)
						<a href={ templ.URL(ContributionURL(o.EventID,o.ThreadID,o.PostID)) } class="text-link">Open affected contribution</a>
						if o.Action=="hide" {
							if o.Appealed {
								<p class="field-note">Your request for another review was received. { ternary(o.AppealReviewed,"It has been reviewed; the later outcome is listed here.","It is awaiting review.") }</p>
							} else if o.CanAppeal {
								<details class="recommendation-editor"><summary>Request another review</summary>@AppealComposer(AppealForm{DecisionID:o.ID,CSRF:p.CSRF})</details>
							}
						}
					</section>
				}
				if p.Outcomes.NextCursor!=nil {
					<a href={ templ.URL(CollectionNextURL(p.URL,p.Outcomes.NextCursor)) } class="text-link">More outcomes</a>
				}
			} else {
				if len(p.Reports.Items)==0 {
					<p>No reports on this page. Use “Report privately” on a discussion contribution when you have a concern.</p>
				}
				for _,r:=range p.Reports.Items {
					<section class="moderation-record" aria-label="Your private report">
						<h2>{ r.EventName }</h2>
						if r.Outcome==nil {
							<p><strong>Awaiting moderator review</strong></p>
						} else {
							@OutcomeSummary(moderation.Outcome{Action:r.Outcome.Action,Reason:r.Outcome.Reason,CreatedAt:r.Outcome.CreatedAt})
						}
						<p class="field-note">{ ternary(r.PostID==r.ThreadID,"Reported question or tip","Reported reply") } · { "posted " }@layouts.Stamp(r.PostCreatedAt)</p>
						<p><strong>{ reportReason(r.Reason) }</strong></p>
						<p class="field-note">{ "Received " }@layouts.Stamp(r.CreatedAt)</p>
						if r.Context!="" {
							<p class="discussion-body"><strong>Your note:</strong> { r.Context }</p>
						}
						<a href={ templ.URL(ContributionURL(r.EventID,r.ThreadID,r.PostID)) } class="text-link">Open reported contribution</a>
					</section>
				}
				if p.Reports.NextCursor!=nil {
					<a href={ templ.URL(CollectionNextURL(p.URL,p.Reports.NextCursor)) } class="text-link">More reports</a>
				}
			}
		</main>
	}
}

templ AppealComposer(f AppealForm) {
	<form action={ "/me/moderation/"+f.DecisionID+"/appeal" } method="post" class="account-form">
		<input type="hidden" name="csrf_token" value={ f.CSRF }/>
		<label class="field">Why should this decision be reviewed again? <span>(up to 2000 characters)</span><textarea name="context" rows="4" maxlength="2000" required>{ f.Context }</textarea></label>
		<p class="field-note">Only you and authorized moderators can see your request. Another review is possible while this is the latest hiding decision and the contribution hasn't been removed.</p>
		if f.CSRF!="" {
			@button.Button(button.Props{Type:button.TypeSubmit,Class:"action action-secondary"}) {
				Request another review
			}
		}
	</form>
}
templ AppealFailure(f AppealForm) {
	@layouts.App("profile","Review request wasn't saved") {
		<main id="main" class="destination-page moderation-page"><h1>Review request wasn't saved</h1><p role="alert">{ f.Error }</p>@AppealComposer(f)
			if f.CSRF=="" {
				<p class="field-note">Your draft is kept above. Copy it before signing in, then return to your outcomes to retry.</p><a href={ templ.URL(signInURL("/me/moderation")) } class="text-link">Sign in to continue</a>
			}
			<a href="/me/moderation" class="text-link moderation-utility">Back to your outcomes</a>
		</main>
	}
}

// ModerationWorkspace opens every moderator page: a way back to the person's
// own space, then the page heading. Moderator work is not a tab of the
// personal account navigation.
templ ModerationWorkspace(back, backLabel, title, intro string) {
	<div class="moderation-toolbar">
		<a href={ templ.URL(back) } class="text-link back-link">
			@layouts.Icon("back")
			<span>{ backLabel }</span>
		</a>
		<span class="moderation-badge">
			@layouts.Icon("shield")
			Moderator tools
		</span>
	</div>
	@layouts.PageHeader(title, intro) {
		{ children... }
	}
}

templ ModerationQueue(p ModerationQueuePage) {
	@layouts.App("profile","Review queue") {
		<main id="main" class="destination-page moderation-page">
			@ModerationWorkspace("/me", "Your profile", "Review queue", "Reported questions, tips and replies. Report counts are context, not votes. Cases about your own contributions go to other moderators.") {
				// One status filter for one list, not a second navigation row.
				<nav class="moderation-filter" aria-label="Case status">
					<a href="/moderation" aria-current={ layouts.CurrentPage(!p.All) }>
						Awaiting review
						if p.PendingKnown {
							<span class="moderation-filter-count">{ layouts.CountLabel(p.Pending) }</span>
						}
					</a>
					<a href="/moderation?state=all" aria-current={ layouts.CurrentPage(p.All) }>All cases</a>
				</nav>
			}
			if len(p.List.Items)==0 && p.Later {
				<div class="destination-state moderation-empty">
					<h2>No more cases</h2>
					<p>Cases may have been decided since this page was opened.</p>
					<a href={ templ.URL(ternary(p.All, "/moderation?state=all", "/moderation")) } class="text-link moderation-utility">Back to the first page</a>
				</div>
			} else if len(p.List.Items)==0 {
				<div class="destination-state moderation-empty">
					if p.All {
						<h2>No cases yet</h2>
						<p>Reported contributions and their decisions will appear here.</p>
					} else {
						<h2>Nothing awaiting review</h2>
						<p>New reports and author review requests will appear here.</p>
						<a href="/moderation?state=all" class="text-link moderation-utility">View all cases</a>
					}
				</div>
			}
			<ol class="moderation-cases" role="list">
				for _,v:=range p.List.Items {
					@ModerationQueueCase(v)
				}
			</ol>
			if p.List.NextCursor!=nil {
				<a href={ templ.URL(CollectionNextURL(p.URL,p.List.NextCursor)) } class="text-link moderation-utility">More cases</a>
			}
		</main>
	}
}

// ModerationQueueCase reads like the case it opens: status, why it was
// reported and for how long, where it was posted, then what was said.
templ ModerationQueueCase(v moderation.QueueItem) {
	{{ pending := v.PendingReports + v.PendingAppeals > 0 }}
	{{ headingID := "case-" + v.Post.ID }}
	<li>
		<article class="moderation-case" aria-labelledby={ headingID }>
			<div class="moderation-case-status">
				if pending {
					<span class="moderation-pill is-pending">Awaiting review</span>
				} else if v.LastAction != "" {
					<span class="moderation-pill">Last decision: { moderationAction(v.LastAction) }</span>
				} else {
					<span class="moderation-pill">Reviewed</span>
				}
				for _, r := range v.PendingReasons {
					<span class="moderation-pill is-reason">{ reasonCount(r) }</span>
				}
				if v.PendingAppeals > 0 {
					<span class="moderation-pill is-reason">{ ternary(v.PendingAppeals == 1, "Author asked for another review", fmt.Sprintf("%d author review requests", v.PendingAppeals)) }</span>
				}
				if v.WaitingSince != nil {
					<span class="moderation-waiting">
						{ ternary(v.PendingReports > 0, "Reported", "Review requested") }{ " " }
						@layouts.Stamp(*v.WaitingSince)
					</span>
				}
			</div>
			<h2 id={ headingID }>
				<a href={ templ.URL("/moderation/posts/"+v.Post.ID) }>{ caseTitle(v.Post) }</a>
			</h2>
			<p class="list-meta">{ startLabel(v.Post.Event.Start) }{ " · " }{ venueLabel(v.Post.Event) }</p>
			if v.Post.Hidden {
				<p class="moderation-placeholder">Hidden by a moderator</p>
			} else if v.Post.Removed {
				<p class="moderation-placeholder">Removed by its author</p>
			} else {
				<blockquote class="discussion-body moderation-excerpt">{ v.Post.Body }</blockquote>
				@PostAttribution(v.Post)
			}
			if summary := pendingSummary(v.PendingReports, v.PendingAppeals); summary != "" {
				<p class="field-note">{ summary } awaiting a decision</p>
			}
		</article>
	</li>
}

templ ModerationCase(p ModerationCasePage) {
	@layouts.App("profile","Review contribution") {
		<main id="main" class="destination-page moderation-page">
			@ModerationWorkspace("/moderation", "Review queue", caseTitle(p.Case.Post), "")
			<p class="list-meta moderation-case-context">{ startLabel(p.Case.Post.Event.Start) }{ " · " }{ venueLabel(p.Case.Post.Event) }</p>
			<section class="moderation-record" aria-labelledby="current-contribution"><h2 id="current-contribution">Contribution</h2>
				<p class="moderation-case-status">
					<span class="moderation-pill">{ ternary(p.Case.Post.Removed,"Removed by the author",ternary(p.Case.Post.Hidden,"Hidden by a moderator","Publicly visible")) }</span>
				</p>
				if p.Case.CurrentBody!="" {
					<blockquote class="discussion-body moderation-excerpt">{ p.Case.CurrentBody }</blockquote>
				} else {
					<p class="field-note">The author removed the text. It cannot be restored.</p>
				}
				if !p.Case.Post.Hidden && !p.Case.Post.Removed {
					@PostAttribution(p.Case.Post)
				}
				<a href={ templ.URL(ContributionURL(p.Case.Post.EventID,p.Case.Post.ThreadID,p.Case.Post.ID)) } class="text-link moderation-utility">See it in the conversation</a>
				<details class="account-token-details">
					<summary>Evidence identifiers</summary>
					<p class="list-meta">Author account: { p.Case.AuthorID }</p>
					if p.Case.Post.ParentID!="" {
						<p class="list-meta">Reply target: { p.Case.Post.ParentID }</p>
					}
				</details>
			</section>
			<section class="moderation-record" aria-labelledby="reported-concerns"><h2 id="reported-concerns">Private reports</h2>
				if len(p.Case.Reports)==0 {
					<p class="field-note">No reports for this contribution.</p>
				}
				<ol class="moderation-timeline" role="list">
					for _,r:=range p.Case.Reports {
						<li>
							<p class="moderation-case-status">
								<span class="moderation-pill is-reason">{ reportReason(r.Reason) }</span>
								<span class={ "moderation-pill", templ.KV("is-pending", !r.Reviewed) }>{ ternary(r.Reviewed,"Reviewed","Awaiting review") }</span>
								<span class="moderation-waiting">
						Reported{ " " }
						@layouts.Stamp(r.CreatedAt)
					</span>
							</p>
							if r.Context!="" {
								<p class="discussion-body">{ r.Context }</p>
							} else {
								<p class="field-note">No context given.</p>
							}
							<details class="account-token-details">
								<summary>{ ternary(r.ReportedBody==p.Case.CurrentBody,"Reporter and text at reporting time","Reporter and text at reporting time (since changed)") }</summary>
								<p class="list-meta">Reporter account: { r.ReporterID }</p>
								<blockquote class="discussion-body">{ r.ReportedBody }</blockquote>
							</details>
						</li>
					}
				</ol>
				if p.Case.NextReportsCursor!=nil {
					<a href={ templ.URL(caseNextURL(p.URL,"reports",p.Case.NextReportsCursor)) } class="text-link moderation-utility">More private reports</a>
				}
			</section>
			if len(p.Case.Appeals)>0 {
				<section class="moderation-record" aria-labelledby="author-requests"><h2 id="author-requests">Author review requests</h2>
					<ol class="moderation-timeline" role="list">
						for _,v:=range p.Case.Appeals {
							<li>
								<p class="moderation-case-status">
									<span class={ "moderation-pill", templ.KV("is-pending", !v.Reviewed) }>{ ternary(v.Reviewed,"Reviewed","Awaiting review") }</span>
									<span class="moderation-waiting">
						Requested{ " " }
						@layouts.Stamp(v.CreatedAt)
					</span>
								</p>
								<p class="discussion-body">{ v.Context }</p>
							</li>
						}
					</ol>
					if p.Case.NextAppealsCursor!=nil {
						<a href={ templ.URL(caseNextURL(p.URL,"appeals",p.Case.NextAppealsCursor)) } class="text-link moderation-utility">More author review requests</a>
					}
				</section>
			}
			// History comes before the decision: a new decision closes everything pending.
			<section class="moderation-record" aria-labelledby="decision-history"><h2 id="decision-history">Earlier decisions</h2>
				if len(p.Case.Decisions)==0 {
					<p class="field-note">No decisions yet.</p>
				}
				<ol class="moderation-timeline" role="list">
					for _,d:=range p.Case.Decisions {
						<li>
							@OutcomeSummary(d.Outcome)
							<p class="list-meta">Moderator account: { d.ModeratorID }</p>
							if d.Notes!="" {
								<p class="discussion-body"><strong>Private notes:</strong> { d.Notes }</p>
							}
						</li>
					}
				</ol>
				if p.Case.NextDecisionsCursor!=nil {
					<a href={ templ.URL(caseNextURL(p.URL,"decisions",p.Case.NextDecisionsCursor)) } class="text-link moderation-utility">More decisions</a>
				}
			</section>
			if p.Error!="" {
				// One alert: what went wrong, then what to do, as separate sentences.
				<div class="account-notice moderation-alert" role="alert">
					<p>{ p.Error }</p>
					<p>The case shown here is current. Review it before recording a decision again.</p>
				</div>
			}
			if p.Case.AuthorID==p.ViewerID {
				<p class="field-note">Another moderator must review your own contribution.</p>
			} else {
				<section class="moderation-record moderation-decision" aria-labelledby="decision-heading"><h2 id="decision-heading">Record a decision</h2>
					<form action={ "/moderation/posts/"+p.Case.Post.ID } method="post" class="account-form">
						<input type="hidden" name="csrf_token" value={ p.CSRF }/><input type="hidden" name="expected_version" value={ fmt.Sprint(p.Case.Version) }/><input type="hidden" name="expected_updated_at" value={ p.Case.Post.UpdatedAt.Format(time.RFC3339Nano) }/>
						<fieldset class="moderation-choices">
							<legend>Decision</legend>
							for _, choice := range decisionChoices(p.Case) {
								<label class="moderation-choice">
									<input type="radio" name="action" value={ choice.Value } required checked?={ p.Review.Action==choice.Value }/>
									<span><strong>{ choice.Label }</strong><span>{ choice.Effect }</span></span>
								</label>
							}
						</fieldset>
						<div class="field">
							<label for="decision-reason">Shared reason <span>(seen by the people your choice names; up to 2000 characters)</span></label>
							<p id="decision-reason-privacy">Never include reporter identities or private evidence in the shared reason.</p>
							<textarea id="decision-reason" name="reason" rows="3" required maxlength="2000" aria-describedby="decision-reason-privacy">{ p.Review.Reason }</textarea>
						</div>
						<label class="field">Private moderator notes <span>(optional, only moderators see them; up to 2000 characters)</span><textarea name="notes" rows="3" maxlength="2000">{ p.Review.Notes }</textarea></label>
						<p class="field-note">Recording a decision closes every report and author review request awaiting review, including any on later pages. Restoring doesn't undo an author's removal.</p>
						@button.Button(button.Props{Type:button.TypeSubmit,Class:"action"}) {
							Record decision
						}
					</form>
				</section>
			}
		</main>
	}
}

templ ModerationDraftFailure(p ModerationCasePage) {
	@layouts.App("profile","Decision wasn't confirmed") {
		<main id="main" class="destination-page moderation-page">
			<h1>Decision wasn't confirmed</h1><p role="alert">{ p.Error }</p>
			<p class="field-note">Your drafts are kept below. Copy them before reopening the case, then check its current history and context before deciding again.</p>
			<div class="account-form">
				<label class="field">Draft decision reason<textarea rows="3" readonly>{ p.Review.Reason }</textarea></label>
				<label class="field">Draft private notes<textarea rows="3" readonly>{ p.Review.Notes }</textarea></label>
			</div>
			<a href={ templ.URL("/moderation/posts/"+p.Case.Post.ID) } class="text-link moderation-utility">Reopen case</a>
			if p.CSRF=="" {
				<a href={ templ.URL(signInURL("/moderation/posts/"+p.Case.Post.ID)) } class="text-link moderation-utility">Sign in to continue</a>
			}
		</main>
	}
}
