package home

import "fmt"
import "github.com/sonastea/ticketopia/internal/models"
import "github.com/sonastea/ticketopia/internal/interests"
import "github.com/sonastea/ticketopia/views/layouts"
import "github.com/sonastea/ticketopia/views/components/button"
import selectcomp "github.com/sonastea/ticketopia/views/components/select"

templ InterestControl(id string, name string, view InterestView, returnURL string) {
	if !view.Enabled {
		@ParticipationButton("interests", "Interested", "")
	} else if view.Error != "" {
		@button.Button(button.Props{Variant:button.VariantOutline,Class:"button-quiet",Disabled:true,Attributes:templ.Attributes{"aria-label":"Interest unavailable for " + name}}) { Interest unavailable }
	} else if !view.SignedIn {
		@button.Button(button.Props{Href:signInURL(returnURL),Variant:button.VariantOutline,Class:"button-quiet",Attributes:templ.Attributes{"aria-label":"Sign in to mark interested — " + name}}) {
			@layouts.Icon("interests")<span>Sign in for Interested</span>
		}
	} else {
		<form method="post" action={ interestAction(id) } class="interest-form" data-interest-form data-interest-id={ id } data-interest-default={ view.DefaultVisibility } data-event-name={ name }>
			<input type="hidden" name="csrf_token" value={ view.CSRF }/>
			<input type="hidden" name="return_to" value={ returnURL }/>
			<input type="hidden" name="action" value={ interestVerb(view.States[id].Interested) }/>
			<input type="hidden" name="visibility" value={ view.visibility(id) }/>
			@button.Button(button.Props{Type:button.TypeSubmit,Variant:button.VariantOutline,Class:"button-quiet interest-button",Attributes:templ.Attributes{"aria-pressed":fmt.Sprint(view.States[id].Interested),"aria-label":"Interested · " + interestLabel(view.visibility(id)) + " — " + interestActionLabel(view.States[id].Interested) + " interest for " + name}}) {
				@layouts.Icon("interests")<span>{ "Interested · " + interestLabel(view.visibility(id)) }</span>
			}
		</form>
	}
}

templ InterestDetails(id string, view InterestView, returnURL string) {
	<div class="interest-details" data-interest-details={ id }>
		if view.Enabled {
			if view.Error != "" {
				<p class="field-note" role="status">{ view.Error }</p>
			} else {
				<p class="interest-count" data-interest-count={ id }><strong>{ fmt.Sprint(view.States[id].Count) }</strong> { interestCountLabel(view.States[id].Count) }</p>
				if view.SignedIn {
					<details class="interest-privacy" name="interest-privacy" data-interest-privacy hidden?={ !view.States[id].Interested }>
						<summary>Change visibility</summary>
						<form method="post" action={ interestAction(id) } data-interest-form data-interest-edit data-interest-id={ id }>
							<input type="hidden" name="csrf_token" value={ view.CSRF }/>
							<input type="hidden" name="return_to" value={ returnURL }/>
							<input type="hidden" name="action" value="set"/>
							<label class="field">Who can see your interest?
								@selectcomp.Native(selectcomp.NativeProps{Name:"visibility"}) {
									<option value="private" selected?={ view.visibility(id) != "public" }>Private — count only</option>
									<option value="public" selected?={ view.visibility(id) == "public" }>Public — show my profile</option>
								}
							</label>
							<p class="field-note">Public shows your profile on this event and this event on your profile.</p>
							@button.Button(button.Props{Type:button.TypeSubmit,Variant:button.VariantOutline,Class:"button-quiet"}) { Save visibility }
						</form>
						@InterestFeedback()
					</details>
				}
			}
		}
	</div>
}

templ InterestFeedback() {
	<div class="interest-feedback" data-interest-feedback role="alert" hidden>
		<p data-interest-message></p>
		@button.Button(button.Props{Type:button.TypeButton,Variant:button.VariantLink,Class:"text-link interest-dismiss",Attributes:templ.Attributes{"data-interest-dismiss":true}}) { Dismiss }
	</div>
}

templ InterestCollection(page InterestCollectionPage) {
	<section class="account-section" aria-labelledby="event-interests-heading">
		<h2 id="event-interests-heading">Events you're interested in</h2>
		<p>Interest is separate from Saved and category preferences. Only choices marked Public name you on event pages and your profile.</p>
		if page.Error != "" {
			<p class="field-note" role="status">{ page.Error }</p>
			<a href={ templ.URL(page.ReturnURL) } class="text-link">Try again</a>
		} else if len(page.List.Items) == 0 {
			<p class="field-note">No event interest on this page. Mark an event Interested while discovering, then return here to manage it.</p>
			<a href="/" class="text-link" data-interest-empty>Discover events</a>
		} else {
			<p class="field-note">Newest interest first. Event details are last-known; check current ticket availability.</p>
			<ul id="event-list" class="event-list">@EventRows(page.events(), page.ReturnURL, "", page.Saves, page.ReturnURL, page.Interests)</ul>
		}
		if page.List.NextCursor != nil {
			<a href={ templ.URL(CollectionNextURL(page.ReturnURL, page.List.NextCursor)) } class="text-link">More interested events</a>
		}
		if page.ReturnURL != "/me/interests" {
			<a href="/me/interests" class="text-link">Back to newest interest</a>
		}
	</section>
}

templ PublicInterestEvents(list interests.List, returnURL string) {
	<section class="account-section" aria-labelledby="public-interests-heading">
		<h2 id="public-interests-heading">Public event interest</h2>
		<p class="field-note">Only explicitly public choices appear here. Interest doesn't establish attendance or ticket ownership.</p>
		if len(list.Items) == 0 {
			<p>No public event interest on this page.</p>
		}
		<ul class="public-interest-list">
			for _, item := range list.Items {
				<li><a class="text-link" href={ templ.URL(eventURL(item.Event.ID, "overview", "/")) }>{ item.Event.Name }</a><p class="field-note">{ startLabel(item.Event.Start) } · { venueLabel(item.Event) }</p></li>
			}
		</ul>
		if list.NextCursor != nil {
			<a class="text-link" href={ templ.URL(CollectionNextURL(returnURL, list.NextCursor)) }>More public interest</a>
		}
	</section>
}

templ PublicParticipants(page EventPage) {
	<p>Interest counts include private choices. Only people who chose Public appear below.</p>
	if !page.Interests.Enabled {
		<p class="field-note">Event interest is unavailable on this server.</p>
	} else if page.ParticipantsError != "" {
		<p class="field-note" role="status">{ page.ParticipantsError }</p>
	} else {
		<div data-public-participants={ page.Detail.Item.ID } data-participants-return={ page.ReturnURL }>
			@ParticipantList(page.Participants)
			if page.Participants.NextCursor != nil {
				<a class="text-link" href={ templ.URL(CollectionNextURL(participantsURL(page.Detail.Item.ID, page.ReturnURL), page.Participants.NextCursor)) }>See more public participants</a>
			}
		</div>
	}
}
templ ParticipantList(list interests.Participants) {
	if len(list.Items) == 0 {
		<p class="field-note">No public participants on this page.</p>
	}
	<ul class="public-interest-list">
		for _, item := range list.Items {
			<li><a class="text-link" href={ templ.URL("/users/" + item.Profile.ID) }>{ item.Profile.DisplayName }</a></li>
		}
	</ul>
}
templ InterestedUsers(event models.Event, list interests.Participants, returnURL string, origin string) {
	@layouts.App("community", "Interested in " + event.Name) {
		<main id="main" class="destination-page">
			<a class="text-link" href={ templ.URL(eventURL(event.ID, "community", origin)) }>Back to event</a>
			<h1>People interested in { event.Name }</h1>
			<p class="intro">Only explicitly public interest is listed. Private interest contributes to counts without naming anyone.</p>
			@ParticipantList(list)
			if list.NextCursor != nil {
				<a class="text-link" href={ templ.URL(CollectionNextURL(returnURL, list.NextCursor)) }>More public participants</a>
			}
		</main>
	}
}
