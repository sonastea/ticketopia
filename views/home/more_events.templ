package home

import "fmt"
import "github.com/sonastea/ticketopia/internal/models"
import "github.com/sonastea/ticketopia/views/layouts"

templ MoreEventsList(page SearchPage) {
	<ul hx-swap-oob="beforeend:#event-list">
		@EventRows(page.Events.Items, page.ReturnURL, page.SelectedID)
	</ul>
	@Pagination(page)
}

templ EventRows(events []models.Event, returnURL string, selectedID string) {
	for _, event := range events {
		<li class="event-row" data-event-id={ event.ID } data-selected={ fmt.Sprint(event.ID == selectedID) }>
			<div class="event-art">
				@EventImage(event, false)
				<div class="date-marker" aria-hidden="true"><span>{ datePart(event.Start, "Jan") }</span><strong>{ datePart(event.Start, "2") }</strong></div>
			</div>
			<div class="event-copy">
				<p class="event-date">{ startLabel(event.Start) }</p>
				<h3><a href={ templ.URL(eventURL(event.ID, "overview", returnURL)) } class="event-link" data-event-link data-id={ event.ID } aria-current={ fmt.Sprint(event.ID == selectedID) }>{ event.Name }</a></h3>
				<p class="event-venue">{ venueLabel(event) }</p>
				<div class="event-metadata"><span class="event-status" data-status={ event.Status }>{ statusLabel(event.Status) }</span><span>{ priceLabel(event.PriceRanges) }</span></div>
				<p class="genre-label">{ classificationLabel(event) }</p>
				<details class="extra-metadata"><summary>More event information</summary>
					if artistsLabel(event.Artists) != "" {
						<p>{ artistsLabel(event.Artists) }</p>
					}
					if saleLabel(event) != "" {
						<p>{ saleLabel(event) }</p>
					}
					if event.Source.URL != "" {
						<a href={ templ.URL(event.Source.URL) } class="text-link" aria-label={ "View tickets for " + event.Name }><span>View tickets on Ticketmaster</span>@layouts.Icon("external")</a>
					}
				</details>
				<div class="event-actions">
					<button type="button" class="button-quiet" disabled aria-describedby="participation-note">@layouts.Icon("saved")<span>Save</span></button>
					<button type="button" class="button-quiet" disabled aria-describedby="participation-note">@layouts.Icon("interests")<span>Interested</span></button>
					<a href={ templ.URL(eventURL(event.ID, "overview", returnURL)) } data-event-link data-id={ event.ID } class="detail-link" aria-label={ "Details for " + event.Name }><span>Details</span>@layouts.Icon("arrow")</a>
				</div>
				<a href="#event-context" class="context-jump text-link">Jump to event preview</a>
			</div>
		</li>
	}
}

templ EventImage(event models.Event, large bool) {
	<div class="event-image">
		<div class="image-fallback" aria-hidden="true">@layouts.Icon(eventIcon(event))</div>
		if imageURL(event.Images) != "" {
			if large {
				<img src={ sizedImageURL(event.Images, 1000) } alt="" width="640" height="360"/>
			} else {
				<img src={ imageURL(event.Images) } alt="" width="480" height="480" loading="lazy" decoding="async"/>
			}
		}
	</div>
}

templ Freshness(meta models.Freshness) {
	if !meta.DataAsOf.IsZero() {
		<p class={ "freshness", templ.KV("is-stale", meta.Stale) }>
			if meta.Stale {
				<strong>Showing saved results while Ticketmaster is unavailable.</strong><span> </span>
			}
			Updated { freshnessLabel(meta.DataAsOf) }. Venue-local event times.
		</p>
	}
}

templ Pagination(page SearchPage) {
	<div id="pagination" class="pagination" aria-live="polite">
		if page.Events.NextCursor != nil {
			<a href={ templ.URL(nextURL(page)) } hx-get={ nextURL(page) } hx-target="#pagination" hx-swap="outerHTML" hx-indicator="#pagination" hx-sync="this:drop" class="action action-secondary"><span class="ready-label">Load more events</span><span class="loading-label">Loading events…</span>@layouts.Icon("chevron")</a>
		} else if page.Events.Limited {
			<p>You've reached Ticketmaster's search limit. Narrow your city, dates, category, or genre to find more relevant events.</p>
		} else if len(page.Events.Items) > 0 {
			<p>You've reached the end of these results.</p>
		}
		if page.Filters.Page > 0 {
			@Freshness(page.Events.Meta)
		}
		<p id="load-error" class="load-error" role="alert"></p>
	</div>
}
