package home

import "fmt"
import "github.com/sonastea/ticketopia/internal/models"
import "github.com/sonastea/ticketopia/internal/eventactivity"
import "github.com/sonastea/ticketopia/internal/radar"
import "github.com/sonastea/ticketopia/views/layouts"
import "github.com/sonastea/ticketopia/views/components/button"
import "github.com/sonastea/ticketopia/views/components/skeleton"

templ MoreEventsList(page SearchPage) {
	<ul hx-swap-oob="beforeend:#event-list">
		@EventRowsWithActivity(page.Events.Items, page.ReturnURL, page.SelectedID, page.Saves, page.ActionReturnURL, page.Interests, page.Activity)
	</ul>
	@Pagination(page)
}

templ EventRows(events []models.Event, returnURL string, selectedID string, saves SaveView, actionReturnURL string, interests InterestView) {
	@EventRowsWithRadar(events, returnURL, selectedID, saves, actionReturnURL, interests, nil)
}

templ EventRowsWithRadar(events []models.Event, returnURL string, selectedID string, saves SaveView, actionReturnURL string, interests InterestView, matches map[string]radar.Item) {
	@EventRowsContent(events, returnURL, selectedID, saves, actionReturnURL, interests, matches, nil, false)
}

templ EventRowsWithActivity(events []models.Event, returnURL string, selectedID string, saves SaveView, actionReturnURL string, interests InterestView, activity map[string]eventactivity.Preview) {
	@EventRowsContent(events, returnURL, selectedID, saves, actionReturnURL, interests, nil, activity, true)
}

templ EventRowsContent(events []models.Event, returnURL string, selectedID string, saves SaveView, actionReturnURL string, interests InterestView, matches map[string]radar.Item, activity map[string]eventactivity.Preview, extended bool) {
	for _, event := range events {
		<li class="event-row" data-event-id={ event.ID } data-selected={ fmt.Sprint(event.ID == selectedID) }>
			<div class="event-art">
				<a href={ templ.URL(eventURL(event.ID, "overview", returnURL)) } data-event-link data-id={ event.ID } tabindex="-1" aria-hidden="true">
					@EventImage(event, artResult)
				</a>
				<div class="date-marker" aria-hidden="true"><span>{ datePart(event.Start, "Jan") }</span><strong>{ datePart(event.Start, "2") }</strong></div>
			</div>
			<div class="event-copy">
				<p class="event-date">
					{ startLabel(event.Start) }
					if extended {
						<span class="viewing-label" aria-hidden="true">@layouts.Icon("viewing")<span>Viewing</span></span>
					}
				</p>
				<h3 style={ transitionStyle("title", event.ID) }><a href={ templ.URL(eventURL(event.ID, "overview", returnURL)) } class="event-link" data-event-link data-id={ event.ID } aria-current={ fmt.Sprint(event.ID == selectedID) }>{ event.Name }</a></h3>
				<p class="event-venue">{ venueLabel(event) }</p>
				<div class="event-metadata">@EventStatus(event.Status)
<span>{ priceLabel(event.PriceRanges) }</span></div>
				<p class="genre-label">{ classificationLabel(event) }</p>
				if item, ok := matches[event.ID]; ok {
					<div class="radar-match">
						<p class="field-note"><strong>Why this event</strong></p>
						<ul class="radar-reasons">
							for _, reason := range item.Reasons {
								<li>{ reason.Text }</li>
							}
						</ul>
						@Freshness(item.Meta)
					</div>
				}
				if !extended {
					@EventRowTools(event, returnURL, saves, actionReturnURL, interests, false)
				}
			</div>
			if extended {
				<div class="event-row-extension">
					<div class="row-details">
						if featuringLabel(event) != "" {
							<p><strong>Featuring</strong> { featuringLabel(event) }</p>
						}
						if sale := saleLabel(event); sale != "" {
							<p class="sale-date">{ sale }</p>
						}
					</div>
					@EventRowActivity(event.ID, activity[event.ID], returnURL)
					@EventRowTools(event, returnURL, saves, actionReturnURL, interests, true)
				</div>
			}
		</li>
	}
}

templ EventRowTools(event models.Event, returnURL string, saves SaveView, actionReturnURL string, interests InterestView, extended bool) {
	if !extended {
		if featuringLabel(event) != "" {
			<p>{ featuringLabel(event) }</p>
		}
		if sale := saleLabel(event); sale != "" {
			<p>{ sale }</p>
		}
	}
	@EventActionControls(event.ID, event.Name, saves, actionReturnURL, false) {
		if event.Source.URL != "" {
			@button.Button(button.Props{Href: event.Source.URL, Variant: button.VariantOutline, Class: "action action-secondary", Attributes: templ.Attributes{"aria-label": "Tickets on Ticketmaster for " + event.Name}}) {
				<span>Tickets on Ticketmaster</span>@layouts.Icon("external")
			}
		} else {
			<p class="field-note">Ticket link unavailable.</p>
		}
		if isInterestsURL(returnURL) {
			@InterestControl(event.ID, event.Name, interests, actionReturnURL)
		}
	}
}

templ EventRowActivity(id string, preview eventactivity.Preview, returnURL string) {
	if preview.Questions > 0 || preview.Recommendations > 0 || layouts.LiveActivityEnabled(ctx) {
		<div class="row-activity" aria-label="Public event activity" data-live-count-group hidden?={ preview.Questions == 0 && preview.Recommendations == 0 }>
			if preview.Questions > 0 {
				<div>
					<h4><a href={ templ.URL(eventURL(id, "discussion", returnURL)) } class="text-link" data-event-link data-id={ id }>{ activityCount(preview.Questions, "question or tip", "questions & tips") }</a></h4>
				</div>
			}
				<div data-live-recommendation-wrap hidden?={ preview.Recommendations == 0 }>
					<h4><a href={ templ.URL(eventURL(id, "community", returnURL)) } class="text-link" data-event-link data-id={ id } data-live-recommendation-count={ id }>{ activityCount(preview.Recommendations, "public recommendation", "public recommendations") }</a></h4>
				</div>
		</div>
	}
}

templ EventImage(event models.Event, slot artSlot) {
	<div class="event-image" style={ transitionStyle("art", event.ID) }>
		<div class="image-fallback" aria-hidden="true">@layouts.Icon(eventIcon(event))
</div>
		if art := artFor(event.Images, slot); art.Src != "" {
			if slot == artDetail {
				<img
					src={ art.Src }
					if art.SrcSet != "" {
						srcset={ art.SrcSet }
						sizes={ art.Sizes }
					}
					alt=""
					width="640"
					height="360"
				/>
			} else {
				<img
					src={ art.Src }
					if art.SrcSet != "" {
						srcset={ art.SrcSet }
						sizes={ art.Sizes }
					}
					alt=""
					width="480"
					height="480"
					loading="lazy"
					decoding="async"
				/>
			}
		}
	</div>
}

templ Freshness(meta models.Freshness) {
	if !meta.DataAsOf.IsZero() {
		<p class={ "freshness", templ.KV("is-stale", meta.Stale) }>
			if meta.Stale {
					<strong>Showing last-known details, not live availability.</strong><span></span>
			}
			Updated { freshnessLabel(meta.DataAsOf) }. Venue-local event times.
		</p>
	}
}

// ResultsFreshness merges result freshness and collection coverage into one
// line so compact screens reach the first event sooner. It renders once on
// load, so it isn't a live region that would re-announce every visit. Warnings
// collapse to a one-line summary with the explanation behind a tap.
templ ResultsFreshness(meta models.Freshness) {
	if summary := resultsNoticeSummary(meta); summary != "" {
		<details
			class={ "freshness freshness-notice", templ.KV("is-stale", meta.Stale) }
			if meta.Coverage != nil {
				data-coverage={ meta.Coverage.Status }
			}
		>
			<summary>{ summary }</summary>
			<p>
				@resultsFreshnessText(meta)
			</p>
		</details>
	} else if !meta.DataAsOf.IsZero() || meta.Coverage != nil {
		<p
			class="freshness"
			if meta.Coverage != nil {
				data-coverage={ meta.Coverage.Status }
			}
		>
			@resultsFreshnessText(meta)
		</p>
	}
}

templ resultsFreshnessText(meta models.Freshness) {
	if meta.Stale {
		<strong>Showing last-known results, not live availability.</strong>{ " " }
	}
	if note := coverageNote(meta); note != "" {
		{ note }{ " " }
	}
	if !meta.DataAsOf.IsZero() {
		Updated { freshnessLabel(meta.DataAsOf) }. Venue-local event times.
	}
}

templ CollectionCoverage(meta models.Freshness) {
	if meta.Coverage != nil {
		<p class="field-note" data-coverage={meta.Coverage.Status}>
			switch meta.Coverage.Status {
				case "not_collected":
					Not collected yet. Ticketmaster could not be refreshed; this is not a confirmed empty search.
				case "partial":
					Partial coverage. Some dates or provider pages are missing; more events may exist. Try a shorter date range.
				case "stale":
					Showing older results from previously completed coverage while collection catches up.
				default:
					Collected coverage for all requested dates. Events not recently confirmed remain last-known records.
			}
		</p>
	}
}

templ Pagination(page SearchPage) {
	<div id="pagination" class="pagination" aria-live="polite" data-page-cursor={ page.PageCursor }>
		if page.ActivityError != "" {
			<p class="field-note" role="status">{ page.ActivityError }</p>
		}
		if page.Events.NextCursor != nil {
			<div class="pagination-skeleton" aria-hidden="true">
				for range 3 {
					<div class="skeleton-row">
						@skeleton.Skeleton(skeleton.Props{Class: "skeleton-art"})
						@skeleton.Skeleton(skeleton.Props{Class: "skeleton-line"})
						@skeleton.Skeleton(skeleton.Props{Class: "skeleton-line"})
						@skeleton.Skeleton(skeleton.Props{Class: "skeleton-line"})
					</div>
				}
			</div>
			@button.Button(button.Props{Href: nextURL(page), Variant: button.VariantOutline, Class: "action action-secondary", Attributes: templ.Attributes{"hx-get": nextURL(page), "hx-target": "#pagination", "hx-swap": "outerHTML", "hx-indicator": "#pagination", "hx-sync": "this:drop"}}) {
				<span class="ready-label">Load more events</span><span class="loading-label">Loading events…</span>@layouts.Icon("chevron")
			}
		} else if page.Events.Limited {
			if page.Events.Meta.Coverage != nil {
				<p>You've reached the end of collected results. Coverage is partial; more events may exist. Try a shorter date range.</p>
			} else {
				<p>You've reached Ticketmaster's search limit. Narrow your city, dates, category, or genre to find more relevant events.</p>
			}
		} else if len(page.Events.Items) > 0 {
			<p>You've reached the end of these results.</p>
		}
		if page.Filters.Page > 0 {
			@ResultsFreshness(page.Events.Meta)
		}
		<p id="load-error" class="load-error" role="alert"></p>
	</div>
}
