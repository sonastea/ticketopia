package home

import "fmt"
import "strings"
import "github.com/sonastea/ticketopia/internal/models"
import "github.com/sonastea/ticketopia/internal/eventactivity"
import "github.com/sonastea/ticketopia/internal/radar"
import "github.com/sonastea/ticketopia/views/layouts"
import "github.com/sonastea/ticketopia/views/components/button"
import "github.com/sonastea/ticketopia/views/components/skeleton"

templ MoreEventsList(page SearchPage) {
	<ul hx-swap-oob="beforeend:#event-list">
		@DiscoverRows(page)
	</ul>
	@Pagination(page)
}

// DiscoverRows reads date-sorted results as an agenda: a calendar heading
// opens each stretch (Today, This week, Next week, later months) and the
// soonest event on the first page leads as a wide card. Headings repeat each
// row's full date, so they're visual only; app.js drops a repeated heading
// when Load more continues the same stretch.
templ DiscoverRows(page SearchPage) {
	for _, row := range discoverRows(page, layouts.Now(ctx)) {
		if row.Group != nil {
			<li class="event-group" aria-hidden="true" data-event-group={ row.Group.Key }>
				<span class="event-group-label">{ row.Group.Label }</span>
				if row.Group.Range != "" {
					<span class="event-group-range">{ row.Group.Range }</span>
				}
			</li>
		}
		@EventRow(row.Event, page.ReturnURL, page.SelectedID, page.Saves, page.ActionReturnURL, page.Interests, nil, page.Activity, true, rowMode{Lead: row.Lead, Kind: row.Kind, Countdown: row.Countdown})
	}
}

templ EventRows(events []models.Event, returnURL string, selectedID string, saves SaveView, actionReturnURL string, interests InterestView) {
	@EventRowsWithRadar(events, returnURL, selectedID, saves, actionReturnURL, interests, nil, nil)
}

templ EventRowsWithRadar(events []models.Event, returnURL string, selectedID string, saves SaveView, actionReturnURL string, interests InterestView, matches map[string]radar.Item, activity map[string]eventactivity.Preview) {
	@EventRowsContent(events, returnURL, selectedID, saves, actionReturnURL, interests, matches, activity, false)
}

templ EventRowsWithActivity(events []models.Event, returnURL string, selectedID string, saves SaveView, actionReturnURL string, interests InterestView, activity map[string]eventactivity.Preview) {
	@EventRowsContent(events, returnURL, selectedID, saves, actionReturnURL, interests, nil, activity, true)
}

templ EventRowsContent(events []models.Event, returnURL string, selectedID string, saves SaveView, actionReturnURL string, interests InterestView, matches map[string]radar.Item, activity map[string]eventactivity.Preview, extended bool) {
	for _, event := range events {
		@EventRow(event, returnURL, selectedID, saves, actionReturnURL, interests, matches, activity, extended, rowMode{})
	}
}

templ EventRow(event models.Event, returnURL string, selectedID string, saves SaveView, actionReturnURL string, interests InterestView, matches map[string]radar.Item, activity map[string]eventactivity.Preview, extended bool, mode rowMode) {
	{{ overviewURL := templ.URL(eventURL(event.ID, "overview", returnURL)) }}
	{{ selected := fmt.Sprint(event.ID == selectedID) }}
	<li class={ "event-row", templ.KV("event-row-lead", mode.Lead) } data-event-id={ event.ID } data-selected={ selected }>
		<div class="event-art">
			<a href={ overviewURL } data-event-link data-id={ event.ID } tabindex="-1" aria-hidden="true">
				if mode.Lead {
					@EventImage(event, artLead)
				} else {
					@EventImage(event, artResult)
				}
			</a>
			if mode.Lead {
				<span class="lead-badge" aria-hidden="true">{ mode.Countdown }</span>
			}
			@EventDateStub(event.Start)
		</div>
		<div class="event-copy">
			<p class="event-date">
				@EventDateLabel(event.Start, mode.Kind)
				if extended {
					<span class="viewing-label" aria-hidden="true">@layouts.Icon("viewing")<span>Viewing</span></span>
				}
			</p>
			<h3 style={ transitionStyle("title", event.ID) }><a href={ overviewURL } class="event-link" data-event-link data-id={ event.ID } aria-current={ selected }>{ event.Name }</a></h3>
			<p class="event-venue">{ venueLabel(event) }</p>
			// The lowest known price leads the facts, in ink; an unknown price
			// keeps its explicit label.
			{{ from := fromPriceLabel(event.PriceRanges) }}
			<div class="event-metadata" role="group" aria-label="Price and sale status">
				if from != "" {
					<strong class="price-tag"><span class="sr-only">Price </span>{ from }</strong>
				}
				@EventStatus(event.Status)
				if from == "" {
					<span>{ priceLabel(event.PriceRanges) }</span>
				}
				if event.Meta != nil && event.Meta.Stale {
					<span class="event-last-known">Last-known as of { freshnessLabel(event.Meta.DataAsOf) }</span>
				}
			</div>
			<p class="genre-label">{ classificationLabel(event) }</p>
			if item, ok := matches[event.ID]; ok {
				<div class="radar-match">
					<p class="field-note"><strong>Why this event</strong></p>
					<ul class="radar-reasons">
						for _, reason := range item.Reasons {
							<li>{ reason.Text }</li>
						}
					</ul>
					if item.Meta.Stale {
						@Freshness(item.Meta)
					}
				</div>
			}
			if !extended {
				@RowQuote(activity[event.ID], false)
				@EventRowDetails(event, false)
				@EventRowTools(event, returnURL, saves, actionReturnURL, interests)
			}
		</div>
		if extended {
			<div class="event-row-extension">
				@EventRowDetails(event, true)
				@RowQuote(activity[event.ID], mode.Lead)
				@EventRowActivity(event.ID, activity[event.ID], returnURL)
				@EventRowTools(event, returnURL, saves, actionReturnURL, interests)
			</div>
		}
	</li>
}

templ EventRowDetails(event models.Event, extended bool) {
	{{ featuring := featuringLabel(event) }}
	{{ sale := upcomingSaleLabel(event, layouts.Now(ctx)) }}
	if featuring != "" || sale != "" {
		<div class="row-details">
			if featuring != "" {
				<p>
					if extended {
						<strong>Featuring</strong>{ " " }
					}
					{ featuring }
				</p>
			}
			if sale != "" {
				<p class="sale-date">{ sale }</p>
			}
		</div>
	}
}

templ EventRowTools(event models.Event, returnURL string, saves SaveView, actionReturnURL string, interests InterestView) {
	@EventActionControlsThen(event.ID, event.Name, saves, actionReturnURL, false, rowInterest(event, returnURL, actionReturnURL, interests)) {
		if event.Source.URL != "" {
			// The event page's Tickets action in its tonal form: the same shape,
			// type and icon, outlined so a list of events doesn't read like a toolbar.
			@button.Button(button.Props{Href: event.Source.URL, Class: "action action-secondary ticket-row-link", Attributes: templ.Attributes{"aria-label": "Tickets on Ticketmaster for " + event.Name}}) {
				// The accessible name keeps the provider and event; the visible label is short so Save fits beside it.
				<span>Tickets</span>@layouts.Icon("external")
			}
		} else {
			<p class="field-note">Ticket link unavailable.</p>
		}
	}
}

// RowQuote gives an event card the newest public recommendation's words, so
// browsing carries people's reasons to go, not only counts. The Up next lead
// shows three lines and other cards two; the full text and author link live in
// the event's Recommendations section. A reason-less recommendation shows
// nothing here.
templ RowQuote(preview eventactivity.Preview, lead bool) {
	if r := preview.Recommendation; r != nil && strings.TrimSpace(r.Body) != "" {
		<figure class={ "pull-quote row-quote", templ.KV("lead-quote", lead) }>
			<blockquote class="recommendation-reason">{ r.Body }</blockquote>
			<figcaption>{ r.AuthorName } recommends this event</figcaption>
		</figure>
	}
}

templ EventRowActivity(id string, preview eventactivity.Preview, returnURL string) {
	if preview.Questions > 0 || preview.Recommendations > 0 || layouts.LiveActivityEnabled(ctx) {
		// Count chips, like the community sections' count pills: each opens the
		// event's section. Live updates rewrite only the inner label.
		<div class="row-activity" aria-label="Public event activity" data-live-count-group hidden?={ preview.Questions == 0 && preview.Recommendations == 0 }>
			if preview.Questions > 0 {
				<div>
					<a href={ templ.URL(eventURL(id, "discussion", returnURL)) } class="activity-chip" data-event-link data-id={ id }>
						@layouts.Icon("message-circle")
						// The visible words begin the accessible name (label in name).
						<span><strong>{ fmt.Sprint(preview.Questions) }</strong>{ ternary(preview.Questions == 1, " question", " questions") }<span class="sr-only">{ ternary(preview.Questions == 1, " or tip", " & tips") }</span></span>
					</a>
				</div>
			}
			<div data-live-recommendation-wrap hidden?={ preview.Recommendations == 0 }>
				<a href={ templ.URL(eventURL(id, "community", returnURL)) } class="activity-chip" data-event-link data-id={ id }>
					@layouts.Icon("quote")
					// "2 recommend" reads as the start of its accessible name, "2 recommend
					// this event"; live updates rebuild the same label (live-activity.js).
					<span data-live-recommendation-count={ id }><strong>{ fmt.Sprint(preview.Recommendations) }</strong>{ ternary(preview.Recommendations == 1, " recommends", " recommend") }<span class="sr-only">{ " this event" }</span></span>
				</a>
			</div>
		</div>
	}
}

templ EventImage(event models.Event, slot artSlot) {
	<div class="event-image" style={ artStyle(event) }>
		<div class="image-fallback" aria-hidden="true">@layouts.Icon(eventIcon(event))
</div>
		if art := artFor(event.Images, slot); art.Src != "" {
			if slot == artDetail || slot == artLead {
				<img
					src={ art.Src }
					if art.SrcSet != "" {
						srcset={ art.SrcSet }
						sizes={ art.Sizes }
					}
					alt=""
					width="640"
					height="360"
				/>
			} else {
				<img
					src={ art.Src }
					if art.SrcSet != "" {
						srcset={ art.SrcSet }
						sizes={ art.Sizes }
					}
					alt=""
					width="480"
					height="480"
					loading="lazy"
					decoding="async"
				/>
			}
		}
	</div>
}

templ Freshness(meta models.Freshness) {
	if !meta.DataAsOf.IsZero() {
		<p class={ "freshness", templ.KV("is-stale", meta.Stale) }>
			if meta.Stale {
					<strong>Showing last-known details, not live availability.</strong><span></span>
			}
			Updated { freshnessLabel(meta.DataAsOf) }. Venue-local event times.
		</p>
	}
}

// ResultsFreshness merges result freshness and collection coverage into one
// line so compact screens reach the first event sooner. It renders once on
// load, so it isn't a live region that would re-announce every visit. Warnings
// collapse to a one-line summary with the explanation behind a tap.
templ ResultsFreshness(meta models.Freshness) {
	if summary := resultsNoticeSummary(meta); summary != "" {
		<details
			class={ "freshness freshness-notice", templ.KV("is-stale", meta.Stale) }
			if meta.Coverage != nil {
				data-coverage={ meta.Coverage.Status }
			}
		>
			<summary>{ summary }</summary>
			<p>
				@resultsFreshnessText(meta)
			</p>
		</details>
	} else if !meta.DataAsOf.IsZero() || meta.Coverage != nil {
		<p
			class="freshness"
			if meta.Coverage != nil {
				data-coverage={ meta.Coverage.Status }
			}
		>
			@resultsFreshnessText(meta)
		</p>
	}
}

// ResultsWarning keeps a stale or partial-coverage warning above the results,
// where it qualifies them; ResultsUpdated puts the routine "Updated …" line
// after them, so the first event comes sooner.
templ ResultsWarning(meta models.Freshness) {
	if resultsNoticeSummary(meta) != "" {
		@ResultsFreshness(meta)
	}
}

templ ResultsUpdated(meta models.Freshness) {
	if resultsNoticeSummary(meta) == "" {
		@ResultsFreshness(meta)
	}
}

templ resultsFreshnessText(meta models.Freshness) {
	if meta.Stale {
		<strong>Showing last-known results, not live availability.</strong>{ " " }
	}
	if note := coverageNote(meta); note != "" {
		{ note }{ " " }
	}
	if !meta.DataAsOf.IsZero() {
		Updated { freshnessLabel(meta.DataAsOf) }. Venue-local event times.
	}
}

// RadarFreshness states, in one visible line, whether results are last-known,
// how complete Radar's coverage is, and when and in which time zone. Radar's
// coverage wording is specific: its 90-day window can't be shortened.
templ RadarFreshness(meta models.Freshness) {
	if meta.Stale || meta.Coverage != nil || !meta.DataAsOf.IsZero() {
		<p
			class={ "freshness", templ.KV("is-stale", meta.Stale) }
			if meta.Coverage != nil {
				data-coverage={ meta.Coverage.Status }
			}
		>
			if meta.Stale {
				<strong>Showing last-known details, not live availability.</strong>{ " " }
			}
			if meta.Coverage != nil {
				switch meta.Coverage.Status {
					case "not_collected":
						Not collected yet. Ticketmaster could not be refreshed; this is not a confirmed empty search.{ " " }
					case "partial":
						Partial coverage. Some dates or provider pages are missing; more events may exist.{ " " }
					case "stale":
						Showing older results from previously completed coverage while collection catches up.{ " " }
					default:
						Collected coverage for all requested dates.{ " " }
				}
			}
			if !meta.DataAsOf.IsZero() {
				Updated { freshnessLabel(meta.DataAsOf) }. Venue-local event times.
			}
		</p>
	}
}

templ Pagination(page SearchPage) {
	<div id="pagination" class="pagination" aria-live="polite" data-page-cursor={ page.PageCursor }>
		if page.ActivityError != "" {
			<p class="field-note" role="status">{ page.ActivityError }</p>
		}
		if page.Events.NextCursor != nil {
			<div class="pagination-skeleton" aria-hidden="true">
				for range 3 {
					<div class="skeleton-row">
						@skeleton.Skeleton(skeleton.Props{Class: "skeleton-art"})
						@skeleton.Skeleton(skeleton.Props{Class: "skeleton-line"})
						@skeleton.Skeleton(skeleton.Props{Class: "skeleton-line"})
						@skeleton.Skeleton(skeleton.Props{Class: "skeleton-line"})
					</div>
				}
			</div>
			@button.Button(button.Props{Href: nextURL(page), Variant: button.VariantOutline, Class: "action action-secondary", Attributes: templ.Attributes{"hx-get": nextURL(page), "hx-target": "#pagination", "hx-swap": "outerHTML", "hx-indicator": "#pagination", "hx-sync": "this:drop"}}) {
				<span class="ready-label">Load more events</span><span class="loading-label">Loading events…</span>@layouts.Icon("chevron")
			}
		} else if page.Events.Limited {
			if page.Events.Meta.Coverage != nil {
				<p>You've reached the end of collected results. Coverage is partial; more events may exist. Try a shorter date range.</p>
			} else {
				<p>You've reached Ticketmaster's search limit. Narrow your city, dates, category, or genre to find more relevant events.</p>
			}
		} else if len(page.Events.Items) > 0 {
			<p>You've reached the end of these results.</p>
		}
		if page.Filters.Page > 0 {
			@ResultsFreshness(page.Events.Meta)
		}
		<p id="load-error" class="load-error" role="alert"></p>
	</div>
}
