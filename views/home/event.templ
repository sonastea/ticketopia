package home

import "github.com/sonastea/ticketopia/internal/models"
import "github.com/sonastea/ticketopia/views/layouts"
import "github.com/sonastea/ticketopia/views/components/button"
import "github.com/sonastea/ticketopia/views/components/badge"
import "github.com/sonastea/ticketopia/views/components/card"
import "github.com/sonastea/ticketopia/views/components/alert"

templ Event(page EventPage) {
	@layouts.App("discover", eventPageTitle(page)) {
		<main id="main" class="event-page">
			@button.Button(button.Props{Href: page.ReturnURL, Variant: button.VariantLink, Class: "text-link back-link", Attributes: templ.Attributes{"data-return-results": true}}) {
				@layouts.Icon("back")
				if isSavedURL(page.ReturnURL) {
					Back to Saved
				} else if isInterestsURL(page.ReturnURL) {
					Back to Interests
				} else if isCommunityURL(page.ReturnURL) {
					Back to Community
				} else if isProfileURL(page.ReturnURL) {
					Back to profile
				} else if page.ReturnURL != "/" {
					Back to results
				} else {
					Discover events
				}
			}
			if page.Error != "" {
				@alert.Alert(alert.Props{Class: "feedback error-state", Variant: alert.VariantDestructive}) {
					<h1>Event unavailable</h1>
					<p>{ page.Error }</p>@button.Button(button.Props{Href: page.ReturnURL, Class: "action"}) {
	Find another event
}
				}
			} else {
				<div class="event-page-grid">
					<article class="event-main">
						@EventImage(page.Detail.Item, true)
						<div class="event-heading">
							<div class="date-marker" aria-hidden="true"><span>{ datePart(page.Detail.Item.Start, "Jan") }</span><strong>{ datePart(page.Detail.Item.Start, "2") }</strong></div>
							<div><h1>{ page.Detail.Item.Name }</h1><p class="event-date">{ startLabel(page.Detail.Item.Start) }</p><p class="event-venue">{ venueLabel(page.Detail.Item) }</p>
								if page.Detail.Meta.Stale {
									@Freshness(page.Detail.Meta)
								}
								@EventFacts(page.Detail.Item)
</div>
						</div>
						@EventParticipation(page, "event-participation-note")
						@EventSections(page)
						@EventSectionContent(page)
					</article>
					@card.Card(card.Props{Class: "event-side", Attributes: templ.Attributes{"role": "complementary", "aria-label": "Tickets and event source"}}) {
						<h2>Make a plan</h2>
						@TicketDetails(page.Detail.Item)
						@Freshness(page.Detail.Meta)
						@SourceFooter()
					}
				</div>
			}
			<p id="save-feedback" class="sr-only" role="status"></p>
		</main>
	}
}

templ EventContext(page EventPage) {
	@card.Card(card.Props{Class: "context-inner", Attributes: templ.Attributes{"data-context-id": page.Detail.Item.ID, "data-context-section": page.Section, "data-context-thread": contextThreadID(page)}}) {
		<div class="context-toolbar"><span>Event & discussion</span>@button.Button(button.Props{Href: page.ReturnURL, Variant: button.VariantGhost, Size: button.SizeIcon, Class: "icon-button", Attributes: templ.Attributes{"data-close-context": true, "aria-label": "Close event preview"}}) {
	@layouts.Icon("close")
}
</div>
		<div class="context-heading"><h2>{ page.Detail.Item.Name }</h2><p class="event-date">{ startLabel(page.Detail.Item.Start) }</p><p class="event-venue">{ venueLabel(page.Detail.Item) }</p>
			if page.Detail.Meta.Stale {
				@Freshness(page.Detail.Meta)
			}
			@EventFacts(page.Detail.Item)
</div>
		@button.Button(button.Props{Href: sectionURL(page, "overview"), Variant: button.VariantLink, Class: "text-link open-event"}) {
			<span>Open full event details</span>@layouts.Icon("arrow")
		}
		<details class="context-event-details">
			<summary>Event details & actions</summary>
			@EventImage(page.Detail.Item, true)
			@EventParticipation(page, "context-participation-note")
			@TicketDetails(page.Detail.Item)
			@Freshness(page.Detail.Meta)
		</details>
		@EventSections(page)
		if page.Thread != nil {
			<div class="context-thread" data-context-thread-url={ page.Thread.URL }>
				<a href={ templ.URL(sectionURL(page, "discussion")) } class="text-link" data-panel-link>Back to questions & tips</a>
				<a href={ templ.URL(page.Thread.URL) } class="text-link">Open full conversation</a>
				@DiscussionContent(*page.Thread)
			</div>
		} else {
			@EventSectionContent(page)
		}
	}
}

templ EventFacts(event models.Event) {
	<div class="event-summary" aria-label="Price and sale status"><strong>{ priceLabel(event.PriceRanges) }</strong>@EventStatus(event.Status)
</div>
	<p class="genre-label">{ classificationLabel(event) }</p>
}

templ EventParticipation(page EventPage, noteID string) {
	@EventActions(page.Detail.Item.ID, page.Detail.Item.Name, page.Saves, page.ActionReturnURL) {
		@InterestControl(page.Detail.Item.ID, page.Detail.Item.Name, page.Interests, page.ActionReturnURL)
		if page.Section != "community" {
			@button.Button(button.Props{Href:recommendURL(page),Variant:button.VariantOutline,Class:"button-quiet",Attributes:templ.Attributes{"data-panel-link":true}}) {
				@layouts.Icon("community")
				<span>Recommend</span>
			}
		}
	}
	@InterestDetails(page.Detail.Item.ID, page.Interests, page.ActionReturnURL)
	<p id={ noteID } class="participation-note">
		if page.Saves.Enabled {
			Saves stay private. Interested doesn't confirm attendance or ticket ownership.
		} else {
			Saving and Interested require accounts to be enabled.
		}
	</p>
	if page.Saves.Error != "" {
		<p class="field-note" role="status">{ page.Saves.Error }</p>
	}
}

templ EventSections(page EventPage) {
	<nav class="section-nav" aria-label="Event sections">
		@SectionLink(page, "overview", "Overview")
		@SectionLink(page, "discussion", "Discussion")
		@SectionLink(page, "community", "Community")
	</nav>
}

templ EventSectionContent(page EventPage) {
	<section class="event-section" aria-labelledby="event-section-heading">
		switch page.Section {
			case "discussion":
				<h2 id="event-section-heading">Questions & tips</h2>
				@DiscussionPanel(page.Detail.Item.ID,page.Discussions,page.ActionReturnURL)
			case "community":
				<h2 id="event-section-heading">Good events are worth sharing</h2>
				@RecommendationPanel(page.Detail.Item.ID,page.Recommendations,page.ActionReturnURL)
				<h3>Public interest</h3>
				@PublicParticipants(page)
			default:
				<h2 id="event-section-heading">About the event</h2>
				if page.Detail.Item.Info != "" {
					<p class="provider-copy">{ page.Detail.Item.Info }</p>
				} else {
					<p>Ticketmaster hasn't supplied a description for this event. Check the ticket page for the latest details.</p>
				}
				if artistsLabel(page.Detail.Item.Artists) != "" {
					<h3>Featuring</h3>
					<p>{ artistsLabel(page.Detail.Item.Artists) }</p>
				}
				if eventPlace(page.Detail.Item).Address != "" {
					<h3>Venue</h3>
					<p>{ venueLabel(page.Detail.Item) }<br/>{ eventPlace(page.Detail.Item).Address } { eventPlace(page.Detail.Item).PostalCode }</p>
				}
				if page.Detail.Item.PleaseNote != "" {
					<h3>Before you go</h3>
					<p class="provider-copy">{ page.Detail.Item.PleaseNote }</p>
				}
				@EventHistory(page.Detail.History)
		}
	</section>
}

templ EventHistory(history *models.EventHistory) {
	<h3>Event history</h3>
	if history == nil {
		<p>No dated observations have been collected for this event yet.</p>
	} else {
		<p>First seen { historyLabel(history.FirstSeen) }. Last seen { historyLabel(history.LastSeen) }.</p>
		if len(history.Changes)==0 {
			<p>No meaningful changes observed yet.</p>
		} else {
			<ul>
				for _,change:=range history.Changes {
					<li><time datetime={ change.ObservedAt.Format("2006-01-02T15:04:05Z07:00") }>{ historyLabel(change.ObservedAt) }</time>: { change.Summary }</li>
				}
			</ul>
		}
		if history.NextBefore != nil {
			<p>Showing the most recent changes. Earlier observations are available through the history API.</p>
		}
		<p>Only observed provider changes are recorded. Disappearance or a failed lookup never means cancellation.</p>
	}
}

templ TicketDetails(event models.Event) {
	<div class="ticket-details">
		<div class="ticket-price"><strong>{ priceLabel(event.PriceRanges) }</strong>@EventStatus(event.Status)
</div>
		if saleLabel(event) != "" {
			<p class="sale-date">{ saleLabel(event) }</p>
		}
		if event.Source.URL != "" {
			@button.Button(button.Props{Href: event.Source.URL, Class: "action ticket-link"}) {
				<span>Tickets on Ticketmaster</span>@layouts.Icon("external")
			}
		} else {
			<p>A ticket link hasn't been supplied for this event.</p>
		}
	</div>
}

templ ParticipationButton(name string, text string, noteID string) {
	@button.Button(button.Props{Variant: button.VariantOutline, Class: "button-quiet", Disabled: true, Attributes: templ.Attributes{"aria-describedby": noteID}}) {
		@layouts.Icon(name)
		<span>{ text }</span>
	}
}

templ EventStatus(status string) {
	@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "event-status", Attributes: templ.Attributes{"data-status": status}}) {
		{ statusLabel(status) }
	}
}

templ SectionLink(page EventPage, section string, text string) {
	@button.Button(button.Props{Href: sectionURL(page, section), Variant: button.VariantGhost, Attributes: templ.Attributes{"data-panel-link": true, "aria-current": layouts.CurrentPage(page.Section == section)}}) {
		{ text }
	}
}
