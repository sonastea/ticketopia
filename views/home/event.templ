package home

import "github.com/sonastea/ticketopia/internal/models"
import "github.com/sonastea/ticketopia/views/layouts"
import "github.com/sonastea/ticketopia/views/components/button"
import "github.com/sonastea/ticketopia/views/components/badge"
import "github.com/sonastea/ticketopia/views/components/alert"

templ Event(page EventPage) {
	@layouts.App("discover", eventPageTitle(page)) {
		<main id="main" class="event-page">
			<div class="event-toolbar">
				@button.Button(button.Props{Href: page.ReturnURL, Variant: button.VariantLink, Class: "text-link back-link", Attributes: templ.Attributes{"data-return-results": true}}) {
					@layouts.Icon("back")
					if isSavedURL(page.ReturnURL) {
						Back to Saved
					} else if isInterestsURL(page.ReturnURL) {
						Back to Interests
					} else if isRadarURL(page.ReturnURL) {
						Back to Radar
					} else if isHappeningNowURL(page.ReturnURL) {
						Back to Happening Now
					} else if isCommunityURL(page.ReturnURL) {
						Back to Community
					} else if isProfileURL(page.ReturnURL) {
						Back to profile
					} else if page.ReturnURL != "/" {
						Back to results
					} else {
						Discover events
					}
				}
				if page.Error == "" {
					@ShareAction(page.Detail.Item)
				}
			</div>
			if page.Error != "" {
				@alert.Alert(alert.Props{Class: "feedback error-state", Variant: alert.VariantDestructive}) {
					<h1>Event unavailable</h1>
					<p>{ page.Error }</p>@button.Button(button.Props{Href: page.ReturnURL, Class: "action"}) {
	Find another event
}
				}
			} else {
				<article class="event-main" data-event-shell={ page.Detail.Item.ID } data-viewer-key={ page.Saves.CSRF }>
					<header class="event-identity" style={ tintStyle(page.Detail.Item) }>
						@EventImage(page.Detail.Item, artDetail)
						@EventHeading(page, false)
					</header>
					@EventPrimaryActions(page)
					@EventSections(page)
					@EventSectionRegion(page, false)
					@EventParticipation(page, "event-participation-note")
					@EventProvenance(page)
				</article>
			}
			<p id="save-feedback" class="sr-only" role="status"></p>
		</main>
	}
}

templ EventContext(page EventPage) {
	<div class="context-inner" data-event-shell={ page.Detail.Item.ID } data-viewer-key={ page.Saves.CSRF } data-context-id={ page.Detail.Item.ID } data-context-section={ page.Section } data-context-thread={ contextThreadID(page) }>
		<div class="context-toolbar">
			@button.Button(button.Props{Href: page.ReturnURL, Variant: button.VariantLink, Class: "context-back text-link", Attributes: templ.Attributes{"data-close-context": true, "aria-label": "Close event preview and return to results"}}) {
				@layouts.Icon("back")
				<span>Back to results</span>
			}
			@ShareAction(page.Detail.Item)
		</div>
		@EventHeading(page, true)
		@EventPrimaryActions(page)
		<div class="context-tools">
			@button.Button(button.Props{Href: sectionURL(page, "overview"), Variant: button.VariantLink, Class: "text-link open-event"}) {
				<span>Open event page</span>@layouts.Icon("arrow")
			}
		</div>
		@EventSections(page)
		@EventSectionRegion(page, true)
		@EventParticipation(page, "context-participation-note")
		@EventProvenance(page)
	</div>
}

// Fragment metadata is inert: the client reconciles persistent controls only
// after validating the event, section, presentation mode and HTTP response.
templ EventSectionResponse(page EventPage, panel bool) {
	@EventSectionRegion(page, panel)
	<template data-event-shell-state>
		<div data-event-shell={ page.Detail.Item.ID } data-viewer-key={ page.Saves.CSRF }>
			@EventHeading(page, panel)
			@EventPrimaryActions(page)
			if !panel {
				@EventImage(page.Detail.Item, artDetail)
			}
			@EventSections(page)
			if panel {
				@EventParticipation(page, "context-participation-note")
			} else {
				@EventParticipation(page, "event-participation-note")
			}
			@EventProvenance(page)
		</div>
	</template>
}

templ EventHeading(page EventPage, panel bool) {
	if panel {
		<div class="context-heading" data-shell-facts>
			<h2 style={ transitionStyle("title", page.Detail.Item.ID) }>{ page.Detail.Item.Name }</h2>
			@EventHeadingFacts(page)
		</div>
	} else {
		<div class="event-heading" data-shell-facts>
			<div class="date-marker" aria-hidden="true"><span>{ datePart(page.Detail.Item.Start, "Jan") }</span><strong>{ datePart(page.Detail.Item.Start, "2") }</strong></div>
			<div>
				<h1 style={ transitionStyle("title", page.Detail.Item.ID) }>{ page.Detail.Item.Name }</h1>
				@EventHeadingFacts(page)
			</div>
		</div>
	}
}

templ EventHeadingFacts(page EventPage) {
	<p class="event-date">{ startLabel(page.Detail.Item.Start) }</p>
	<p class="event-venue">{ venueLabel(page.Detail.Item) }</p>
	if page.Detail.Meta.Stale {
		@Freshness(page.Detail.Meta)
	}
	@EventFacts(page.Detail.Item)
}

templ EventSectionRegion(page EventPage, panel bool) {
	<div data-event-section-region data-event-id={ page.Detail.Item.ID } data-section={ page.Section } data-presentation={ eventPresentation(panel) } data-action-return={ page.ActionReturnURL } data-section-thread={ contextThreadID(page) }>
		<p class="field-note" data-section-status role="status" hidden></p>
		<div data-section-body>
			if panel && (page.Section == "overview" || page.Section == "") {
				@EventImage(page.Detail.Item, artDetail)
			}
			<div class={ "context-content", templ.KV("context-activity", page.Thread != nil) }>
				if page.Thread != nil {
					<div class="context-thread" data-context-thread-url={ page.Thread.URL }>
						<a href={ templ.URL(sectionURL(page, "discussion")) } class="text-link" data-panel-link>Back to questions & tips</a>
						<a href={ templ.URL(page.Thread.URL) } class="text-link">Open full conversation</a>
						@DiscussionContent(*page.Thread)
					</div>
					<section class="event-section" aria-label="Event community">
						<h2>Recommendations</h2>
						@RecommendationPanel(page.Detail.Item.ID, page.Recommendations, page.ActionReturnURL)
						<h3>Public interest</h3>
						@PublicParticipants(page)
					</section>
				} else {
					@EventSectionContent(page)
				}
			</div>
		</div>
	</div>
}

templ EventPrimaryActions(page EventPage) {
	<div class="event-primary-actions">
		if saleLabel(page.Detail.Item) != "" {
			<p class="sale-date">{ saleLabel(page.Detail.Item) }</p>
		}
		@EventActionControls(page.Detail.Item.ID, page.Detail.Item.Name, page.Saves, page.ActionReturnURL, false) {
			@TicketAction(page.Detail.Item)
		}
		<p class="field-note">Saves stay private. Saving doesn't reserve tickets or enable reminders.</p>
		if page.Saves.Error != "" {
			<p class="field-note" role="status">{ page.Saves.Error }</p>
		}
	</div>
}

templ EventProvenance(page EventPage) {
	<details class="event-provenance">
		<summary>Event source & history</summary>
		@Freshness(page.Detail.Meta)
		@SourceFooter()
		@EventHistory(page.Detail.History)
	</details>
}

templ EventFacts(event models.Event) {
	<div class="event-summary" aria-label="Price and sale status">
		<strong>{ priceLabel(event.PriceRanges) }</strong>@EventStatus(event.Status)
	</div>
	<p class="genre-label">{ classificationLabel(event) }</p>
}

templ EventParticipation(page EventPage, noteID string) {
	<section class="event-participation" aria-labelledby={ noteID + "-heading" }>
		<h2 id={ noteID + "-heading" }>Your plans & community</h2>
		if page.Interests.Enabled || page.Recommendations.Enabled || page.Saves.Reminders {
			<div class="event-action-group" data-event-actions>
				<div class="event-actions">
					@InterestControl(page.Detail.Item.ID, page.Detail.Item.Name, page.Interests, page.ActionReturnURL)
					@button.Button(button.Props{Href: recommendURL(page), Variant: button.VariantOutline, Class: "button-quiet", Attributes: templ.Attributes{"data-panel-link": true, "data-recommend-intent": true, "hidden": page.Section == "community"}}) {
						@layouts.Icon("community")
						<span>Recommend</span>
					}
					@ReminderControl(page.Detail.Item.ID, page.Detail.Item.Name, page.Saves)
				</div>
				@InterestFeedback()
			</div>
		}
		@InterestDetails(page.Detail.Item.ID, page.Interests, page.ActionReturnURL)
		<p id={ noteID } class="participation-note">
			if page.Saves.Enabled {
				Interested is separate from Save; its visibility is your choice. Recommendations are public. Neither confirms attendance or ticket ownership.
			} else {
				Saving and Interested require accounts to be enabled.
			}
		</p>
	</section>
}

templ EventSections(page EventPage) {
	<nav class="section-nav event-section-nav" aria-label="Event sections">
		@SectionLink(page, "overview", "Overview")
		@SectionLink(page, "discussion", "Questions & tips")
		@SectionLink(page, "community", "Recommendations")
	</nav>
}

templ EventSectionContent(page EventPage) {
	<section class="event-section" aria-labelledby="event-section-heading">
		switch page.Section {
			case "discussion":
				<h2 id="event-section-heading">Questions & tips</h2>
				@DiscussionPanel(page.Detail.Item.ID, page.Discussions, page.ActionReturnURL)
			case "community":
				<h2 id="event-section-heading">Recommendations</h2>
				@RecommendationPanel(page.Detail.Item.ID, page.Recommendations, page.ActionReturnURL)
				<h3>Public interest</h3>
				@PublicParticipants(page)
			default:
				<h2 id="event-section-heading">About the event</h2>
				if page.Detail.Item.Info != "" {
					<p class="provider-copy">{ page.Detail.Item.Info }</p>
				} else {
					<p>Ticketmaster hasn't supplied a description for this event. Check the ticket page for the latest details.</p>
				}
				if featuringLabel(page.Detail.Item) != "" {
					<h3>Featuring</h3>
					<p>{ featuringLabel(page.Detail.Item) }</p>
				}
				if eventPlace(page.Detail.Item).Address != "" {
					<h3>Venue</h3>
					<p>{ venueLabel(page.Detail.Item) }</p>
					<a href={ templ.SafeURL(mapsURL(page.Detail.Item)) } class="text-link venue-map-link" data-maps-query={ mapsQuery(page.Detail.Item) }>
						@layouts.Icon("location")
						<span>{ eventPlace(page.Detail.Item).Address } { eventPlace(page.Detail.Item).PostalCode }<span class="sr-only"> (open in Maps)</span></span>
					</a>
				}
				if page.Detail.Item.PleaseNote != "" {
					<h3>Before you go</h3>
					if intro, items := noticeList(page.Detail.Item.PleaseNote); len(items) > 0 {
						if intro != "" {
							<p>{ intro }</p>
						}
						<ul class="notice-list">
							for _, item := range items {
								<li>{ item }</li>
							}
						</ul>
					} else {
						<p class="provider-copy">{ page.Detail.Item.PleaseNote }</p>
					}
				}
		}
	</section>
}

templ EventHistory(history *models.EventHistory) {
	<h3>Event history</h3>
	if history == nil {
		<p>No dated observations have been collected for this event yet.</p>
	} else {
		<p>First seen { historyLabel(history.FirstSeen) }. Last seen { historyLabel(history.LastSeen) }.</p>
		if len(history.Changes)==0 {
			<p>No meaningful changes observed yet.</p>
		} else {
			<ul>
				for _,change:=range history.Changes {
					<li><time datetime={ change.ObservedAt.Format("2006-01-02T15:04:05Z07:00") }>{ historyLabel(change.ObservedAt) }</time>: { change.Summary }</li>
				}
			</ul>
		}
		if history.NextBefore != nil {
			<p>Showing the most recent changes. Earlier observations are available through the history API.</p>
		}
		<p>Only observed provider changes are recorded. Disappearance or a failed lookup never means cancellation.</p>
	}
}

templ TicketDetails(event models.Event) {
	<div class="ticket-details">
		<div class="ticket-price">
			<strong>{ priceLabel(event.PriceRanges) }</strong>@EventStatus(event.Status)
		</div>
		if saleLabel(event) != "" {
			<p class="sale-date">{ saleLabel(event) }</p>
		}
		@TicketAction(event)
	</div>
}

templ TicketAction(event models.Event) {
	if event.Source.URL != "" {
		@button.Button(button.Props{Href: event.Source.URL, Class: "action ticket-link"}) {
			// The provider stays in the accessible name when a narrow action bar hides it.
			<span>Tickets<span class="ticket-provider">{ " on Ticketmaster" }</span></span>@layouts.Icon("external")
		}
	} else {
		<p>A ticket link hasn't been supplied for this event.</p>
	}
}

// ShareAction opens the device share sheet, or copies the link where there is
// none. It needs JavaScript, so CSS shows it only once the head script finds
// either capability. It sits in the toolbar so the compact Tickets bar keeps
// Save on one row.
templ ShareAction(event models.Event) {
	<div class="share-action">
		<p class="share-feedback" role="status" data-share-feedback></p>
		@button.Button(button.Props{Variant: button.VariantOutline, Class: "button-quiet share-button", Attributes: templ.Attributes{"data-share-url": shareURL(event.ID), "data-share-title": event.Name, "aria-label": "Share " + event.Name}}) {
			@layouts.Icon("share")
		}
	</div>
}

templ ParticipationButton(name string, text string, noteID string) {
	@button.Button(button.Props{Variant: button.VariantOutline, Class: "button-quiet", Disabled: true, Attributes: templ.Attributes{"aria-describedby": noteID}}) {
		@layouts.Icon(name)
		<span>{ text }</span>
	}
}

templ EventStatus(status string) {
	@badge.Badge(badge.Props{Variant: badge.VariantOutline, Class: "event-status", Attributes: templ.Attributes{"data-status": status}}) {
		{ statusLabel(status) }
	}
}

templ SectionLink(page EventPage, section string, text string) {
	<a href={ templ.URL(sectionURL(page, section)) } data-panel-link data-event-section={ section } aria-current={ layouts.CurrentPage(page.Section == section || (page.Section == "" && section == "overview")) }>
		{ text }
	</a>
}
