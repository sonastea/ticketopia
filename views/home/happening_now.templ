package home

import "fmt"
import "github.com/sonastea/ticketopia/internal/models"
import "github.com/sonastea/ticketopia/views/layouts"

templ HappeningNow(p HappeningNowPage) {
	@layouts.App("community", "Happening Now") {
		<main id="main" class="destination-page community-page live-activity" data-live-page data-live-guest?={ !p.SignedIn && p.Error == "" }>
			<header class="page-header account-heading">
				<div class="live-heading">
					<h1 tabindex="-1" data-live-heading>Happening Now</h1>
					// The stream's state in one word, read like the heading's subtitle.
					<p class="live-signal" data-live-signal hidden><span class="live-dot" aria-hidden="true"></span><span data-live-signal-label>Live</span></p>
				</div>
				<p class="intro">See what people are recommending right now.</p>
			</header>
			@CommunityNav("happening-now")
			if !p.Enabled {
				<p>Live activity is unavailable on this server.</p>
			} else {
				<div class="live-filter-bar">
					<p class="list-meta" data-live-summary>{ p.summary() }</p>
					<form id="live-filter-form" class="account-form" method={ happeningMethod(p.SignedIn) } action={ happeningAction(p.SignedIn) } data-live-filter-form>
						if p.SignedIn {
							<input type="hidden" name="csrf_token" value={ p.CSRF }/>
							<input type="hidden" name="revision" value={ fmt.Sprint(p.Revision) }/>
							<input type="hidden" name="return_to" value="/happening-now"/>
							if p.LiveEnabled {
								<input type="hidden" name="enabled" value="on"/>
							}
						}
						@layouts.LiveFilterFields(p.editingFilters(), p.Categories, p.Editor)
					</form>
					<div class="account-actions">
						<button type="button" class="card-action-secondary" data-live-hide hidden>@layouts.Icon("bell-off")<span>Hide activity toasts</span></button>
						<button type="button" class="card-action-secondary" data-live-show hidden>@layouts.Icon("bell")<span>Show activity toasts</span></button>
						<a href={ templ.URL(p.ReturnURL) } class="card-action-secondary" data-live-refresh>@layouts.Icon("refresh-cw")<span>Refresh</span></a>
					</div>
				</div>
				<p class="field-note" data-live-paused hidden?={ !p.Paused }>Live activity is paused or disabled. <a class="text-link" href="/me/preferences">Notification preferences</a></p>
				<section data-live-details hidden?={ p.Paused } aria-label="Recent activity">
					<h2 class="empty-display" data-live-empty-state hidden?={ p.Error != "" || len(p.Snapshot.Items) > 0 }>
						{ ternary(p.Filters.Unrestricted(), "No recommendations in the last 10 minutes", "No recent recommendations match these filters") }
					</h2>
					<p class="field-note" data-live-connection>
						if p.Error != "" {
							{ p.Error }
						} else if len(p.Snapshot.Items) == 0 {
							if p.Filters.Unrestricted() {
								New public recommendations appear here as people share them.
							} else {
								Clear the filters to see all recent recommendations.
							}
						} else {
							Recent public recommendations
						}
					</p>
					<button type="submit" form="live-filter-form" name="filter_action" value="reset" formnovalidate class="action live-empty-action" data-live-empty-reset hidden?={ p.Error != "" || len(p.Snapshot.Items) > 0 || p.Filters.Unrestricted() }>Reset filters</button>
					<a href="/community" class="action live-empty-action" data-live-empty-community hidden?={ p.Error != "" || len(p.Snapshot.Items) > 0 || !p.Filters.Unrestricted() }>Browse earlier recommendations</a>
					if !p.Snapshot.AsOf.IsZero() {
						<p class="list-meta">{ "Page snapshot: " }@layouts.Stamp(p.Snapshot.AsOf)</p>
					}
					<button type="button" class="text-link" data-live-updates hidden></button>
					<span data-live-badge class="sr-only"></span>
					// Cards added live have no stored artwork yet; they reuse this fallback.
					<template data-live-art>
						<div class="event-art">@EventImage(models.Event{}, artThumb)
</div>
					</template>
					<ul class="live-cards" data-live-list>
						for _, item := range p.Snapshot.Items {
							<li class="live-card" data-id={ item.EventID }>
								if event, ok := p.Events[item.EventID]; ok {
									<div class="event-art">
										@EventImage(event, artThumb)
										@EventDateStub(event.Start)
									</div>
								} else {
									<div class="event-art">@EventImage(models.Event{}, artThumb)
</div>
								}
								<div class="live-card-copy">
									<p class="byline"><span class="avatar" aria-hidden="true" data-live-avatar>{ liveInitials(item) }</span><span data-live-attribution>{ activityAttribution(item) }</span></p>
									<a class="text-link live-card-link" data-event-link data-live-event-link data-id={ item.EventID } href={ templ.URL(eventURL(item.EventID, "overview", p.ReturnURL)) }>{ item.EventTitle }</a>
									if event, ok := p.Events[item.EventID]; ok {
										<p class="event-date">@EventDateLabel(event.Start, "")</p>
									}
									<p class="field-note" data-live-meta>{ p.meta(item) }</p>
								</div>
							</li>
						}
					</ul>
				</section>
			}
		</main>
	}
}

func happeningMethod(signedIn bool) string { if signedIn { return "post" }; return "get" }
func happeningAction(signedIn bool) string { if signedIn { return "/me/live-activity-preferences" }; return "/happening-now" }
