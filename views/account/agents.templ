package account

import "github.com/sonastea/ticketopia/views/layouts"

templ AgentGuide(p AgentGuidePage) {
	@layouts.App("", "Agents and API access") {
		<main id="main" class="destination-page agent-guide">
			@layouts.PageHeader("Agents and API access", agentIntro(p)) {
				<nav class="account-actions" aria-label="On this page">
					<a class="text-link" href="#access">What you can do</a>
					if p.MCP {
						<a class="text-link" href="#connect">Connect an agent</a>
					}
					if p.Accounts {
						<a class="text-link" href="#api-tokens">Use an API token</a>
					}
					if p.Drafts {
						<a class="text-link" href="#drafts">Review drafts</a>
					}
					if p.Accounts {
						<a class="text-link" href="#revoke">Remove access</a>
					}
				</nav>
			}
			<section class="agent-guide-section">
				<h2 id="access">What agents and scripts can do</h2>
				<p>The JSON API can search events and read event details and categories. Where available, it can also read Happening Now and public community activity: profiles, recommendations, public Interested choices, questions, tips and replies.</p>
				if p.Accounts {
					<p>Private Interested choices count toward event totals but never name you. Some features, like on-sale reminders, depend on what’s enabled on the site.</p>
				}
				<p>
					Public API reads don’t need a token.
					if p.SignInRequired {
						MCP can read the same public information.
						On this site, MCP asks you to sign in even for public tools.
					} else if p.MCP {
						MCP can read the same public information without sign-in.
					}
				</p>
				if p.MCP && p.Accounts {
					@agentGuidePermissions(p)
				}
				<a class="text-link" href="/api/v1/openapi.yaml">Read the OpenAPI spec (YAML)</a>
			</section>
			if p.MCP {
				@agentGuideConnect(p)
			}
			if p.Accounts {
				@agentGuideTokens(p)
			}
			if p.Drafts {
				<section class="agent-guide-section">
					<h2 id="drafts">Review what an agent writes</h2>
					<p>Through MCP, anything an agent writes for the community—a recommendation reason, question, tip or reply—waits privately in <strong>Agent drafts</strong>. You decide whether to publish or discard it. An agent using MCP can never edit or remove your posts.</p>
					<a class="text-link" href="/me/drafts">Open Agent drafts</a>
				</section>
			}
			if p.Accounts {
				@agentGuideRevoke(p)
			}
		</main>
	}
}

templ agentGuidePermissions(p AgentGuidePage) {
	<h3>What an agent can do with your account</h3>
	<dl class="agent-guide-permissions">
		<dt>Read <code>read</code></dt>
		<dd>Search events, artists and venues. Read your radar, saved events, on-sale reminders, the artists, venues and discussions you follow, Interested events, recommendations, reply updates and preferences.
			if p.Drafts {
				Read your pending drafts.
			}
			The agent can’t see your email or change your profile or preferences.
		</dd>
		<dt>
			if p.OAuth {
				Allow private changes
			} else {
				Make changes
			}
			<code>write</code>
		</dt>
		<dd>Save or remove events, set or stop on-sale reminders, follow or unfollow artists, venues and discussions, and mark reply updates read. Mark events Interested privately, make choices private or remove them.
			if p.Drafts {
				Create drafts for you to review, or discard them.
			}
		</dd>
		if p.OAuth {
			<dt>Also allow posting publicly <code>publish</code></dt>
			<dd>Make your Interested choices public, recommend events without a reason, withdraw recommendations an app posted without a reason, and mark or unmark questions, tips and replies Helpful. An app’s recommendations show its name and host publicly.</dd>
		}
	</dl>
}

templ agentGuideConnect(p AgentGuidePage) {
	{{ mcpURL := p.Origin + "/mcp" }}
	<section class="agent-guide-section">
		if p.OAuth {
			<h2 id="connect">Connect an agent with OAuth</h2>
		} else {
			<h2 id="connect">Connect an agent</h2>
		}
		<p>Add Ticketopia as a remote MCP server in your app. Choose <strong>Streamable HTTP</strong> (often just <strong>HTTP</strong>), not legacy SSE or stdio.</p>
		if p.Origin == "" {
			<p>Use the site address in your browser (including <code>https://</code> or <code>http://</code>) and add <code>/mcp</code> after the host and port, if shown.</p>
		}
		@agentGuideCode("mcp-endpoint", "MCP endpoint", mcpURL)
		if p.OAuth {
			<p>For OAuth, don’t add a token header.</p>
			<div class="agent-guide-examples">
				@agentGuideCode("claude-code", "Claude Code", agentCommand("claude mcp add --transport http ticketopia", "", mcpURL))
				<p>In Claude Code, open <code>/mcp</code> and choose Ticketopia to sign in.</p>
				@agentGuideCode("opencode", "OpenCode", agentCommand("opencode mcp add ticketopia", "--url ", mcpURL))
				<p>In OpenCode, open <code>/mcps</code> and choose Ticketopia to sign in.</p>
			</div>
			<p>When your app opens Ticketopia in a browser, sign in if asked. Check the app’s name, who published it (its website), and the Ticketopia account you’re connecting. Only continue if you started the request yourself.</p>
			<p><strong>Allow private changes</strong> and <strong>Allow public actions as [your name]</strong> are separate choices and both start unchecked. Leave both off for read-only access.</p>
			<p>Other clients can connect if they support MCP OAuth with a Client ID Metadata Document. Clients that only support Dynamic Client Registration can’t sign in here. A hosted client needs a public HTTPS URL.</p>
		} else if p.Accounts {
			<p>To use your account, choose a client that can send a custom header and send <code>Authorization: Bearer TOKEN</code>. OAuth sign-in isn’t enabled on this site.</p>
			<a class="text-link" href="#api-tokens">Set up an API token</a>
		}
	</section>
}

templ agentGuideTokens(p AgentGuidePage) {
	<section class="agent-guide-section">
		<h2 id="api-tokens">Use an API token</h2>
		<p>In <strong>Security &amp; Apps</strong>, open <strong>Create an API token</strong>, name your token, and choose <strong>Create API token</strong>. Copy it when it appears: you won’t see it again. It expires 30 days after you create it. <strong>Treat API tokens like passwords.</strong></p>
		<a class="text-link" href="/me/security#api-access">Go to API tokens in Security &amp; Apps</a>
		<p>Store the token in an environment variable named <code>TICKETOPIA_TOKEN</code> and send it as <code>Authorization: Bearer TOKEN</code>. This example reads your profile without changing it or putting the header on the command line:</p>
		@agentGuideCode("curl", "Read your profile with curl", agentProfileCurl(p.Origin))
		<p><strong>On the JSON API (<code>/api/v1</code>):</strong> a token can read your email and private account data, and change your profile, preferences, saved events, follows and reminders. It can make your Interested choices public, publish recommendations and posts, edit or remove your own posts, and react. It can revoke itself, but can’t list tokens, create new ones or revoke any other token.</p>
		if p.MCP {
			<p><strong>On <code>/mcp</code>:</strong> a client that supports custom headers can send the same Bearer header. An API token gets <code>read</code> and <code>write</code>, never <code>publish</code>. These limits don’t apply on the JSON API.
				if p.OAuth {
					Prefer OAuth for agents: you can choose what each app is allowed to do, and its OAuth token works only on <code>/mcp</code>, not on the JSON API.
				}
			</p>
		}
	</section>
}

templ agentGuideRevoke(p AgentGuidePage) {
	<section class="agent-guide-section">
		<h2 id="revoke">Remove access</h2>
		<ul class="account-connect-list">
			if p.OAuth {
				<li>Under <strong>Connected apps</strong> in Security &amp; Apps, choose <strong>Disconnect</strong> to stop an app’s access immediately. An OAuth access token lasts one hour. The connection expires 30 days after you connect or after the app last refreshes its access.</li>
			}
			<li>Under <strong>API tokens</strong>, choose <strong>Revoke</strong> next to a token to stop it working.
				if p.MCP {
					This stops it on both the API and MCP.
				}
			</li>
			<li>Under <strong>All devices</strong>, choose <strong>Sign out of all devices</strong> and confirm to end every browser session
				if p.OAuth {
					and remove all token and app access.
				} else {
					and revoke every token.
				}
				Ordinary <strong>Sign out</strong> only ends your current browser session.
			</li>
		</ul>
		<a class="text-link" href="/me/security">Manage access in Security &amp; Apps</a>
		<h3>A few safety tips</h3>
		<p>
			if p.OAuth {
				Start with read-only access and connect only apps you trust.
			}
			Never paste a token into a chat or commit it to code. If a token gets shared by mistake, revoke it right away.
		</p>
	</section>
}

templ agentGuideCode(id, label, snippet string) {
	<figure class="agent-guide-example">
		<figcaption id={ id }>{ label }</figcaption>
		<pre class="agent-guide-code" role="region" tabindex="0" aria-labelledby={ id }><code>{ snippet }</code></pre>
	</figure>
}
