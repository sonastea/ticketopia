package account

import "net/url"
import "fmt"
import "github.com/sonastea/ticketopia/internal/accounts"
import "github.com/sonastea/ticketopia/internal/interests"
import "github.com/sonastea/ticketopia/internal/recommendations"
import "github.com/sonastea/ticketopia/views/home"
import "github.com/sonastea/ticketopia/views/layouts"
import "github.com/sonastea/ticketopia/views/components/button"
import "github.com/sonastea/ticketopia/views/components/input"
import "github.com/sonastea/ticketopia/views/components/label"
import "github.com/sonastea/ticketopia/views/components/alert"

templ SignIn(enabled bool, returnTo string, message string) {
	@SignInContext(enabled, returnTo, message, "", "")
}

// intent is "save" when sign-in will complete a Save the visitor already chose.
templ SignInContext(enabled bool, returnTo string, message string, eventName string, intent string) {
	@layouts.App("profile", "Sign in") {
		<main id="main" class="destination-page account-page">
			<div class="account-sign-in">
				<h1>Your event life, your space.</h1>
				if message != "" {
					<p role="status" class="account-notice">{ message }</p>
				}
				if section := signInSection(returnTo); section != "" {
					// What happens to the event is its own short section.
					<section class="sign-in-event" aria-label="After sign-in">
						if eventName != "" {
							<h2>{ eventName }</h2>
						}
						if intent == "save" {
							<p>After sign-in, we'll save this event to your private Saved list and return you to its { section } section.</p>
							<p class="field-note">Signing in doesn't mark interest, publish a recommendation, change visibility, or set up reminders.</p>
						} else {
							<p>After sign-in, you'll return to this event's { section } section. Choose your action there.</p>
							<p class="field-note">Signing in doesn't save an event, mark interest, publish a recommendation, change visibility, or set up reminders.</p>
						}
					</section>
				}
				if enabled && signInConnects(returnTo) {
					<p>An app wants to connect to your Ticketopia account. After sign-in, you'll see what it can do and choose whether to connect it.</p>
				}
				if enabled {
					<p>Sign in to create your Ticketopia profile and keep your preferences across visits and devices.</p>
					@button.Button(button.Props{Href: googleStartURL(returnTo, intent), Class: "google-sign-in"}) {
						<span class="google-sign-in-logo" aria-hidden="true">
							<img src="/assets/google-g.png" width="20" height="20" alt="" aria-hidden="true"/>
						</span>
						<span>Sign in with Google</span>
					}
					<p class="field-note">Google handles sign-in: Ticketopia never receives your Google password and only asks for your account identity and email, not your contacts, calendar or Gmail. Your email and preferences stay private. Your display name and bio are public; you don't have to use your real name.</p>
				} else {
					<p>Accounts aren't enabled on this server. You can still discover events without signing in.</p>
				}
				<a href={ templ.URL(signInBackURL(returnTo)) } class="text-link">{ signInBackLabel(returnTo) }</a>
			</div>
		</main>
	}
}

templ Failure(message string) {
	@layouts.App("profile", "Account request couldn't finish") {
		@layouts.ErrorPage("Account request couldn't finish", message, "") {
			@button.Button(button.Props{Href: "/me", Class: "action"}) {
				Return to your profile
			}
			<a href="/auth/sign-in" class="text-link">Start sign-in again</a>
			<a href="/" class="text-link">Discover events without signing in</a>
		}
	}
}

// Task failures keep native recovery in the event journey, not the account area.
templ EventTaskFailure(message string, returnURL string, signIn bool) {
	@layouts.App("discover", "Event request couldn't finish") {
		@layouts.ErrorPage("Event request couldn't finish", message, "Return to the event or collection to check its current state, then try again.") {
			@button.Button(button.Props{Href: returnURL, Class: "action"}) {
				Return and try again
			}
			if signIn {
				<a href={ templ.URL("/auth/sign-in?return_to=" + url.QueryEscape(returnURL)) } class="text-link">Sign in to continue here</a>
			}
		}
	}
}

templ CSRF(token string) {
	<input type="hidden" name="csrf_token" value={ token }/>
}

templ Settings(p Page) {
	@layouts.App(p.Active(), p.Title()) {
		<main id="main" class={ "destination-page account-page", "account-page-" + p.Section }>
			@layouts.AccountHeader(p.Title(), p.Intro(), p.Section, p.Navigation)
			if p.Error != "" {
				@alert.Alert(alert.Props{Class: "feedback error-state", Variant: alert.VariantDestructive}) {
					<h2>Changes weren't saved</h2><p>{ p.Error }</p>
				}
			}
			if p.NoticeFor == "" {
				@layouts.SectionNotice(p.Notice)
			}
			switch p.Section {
				case "privacy":
					@Privacy(p)
				case "preferences":
					@Preferences(p)
				case "security":
					@Security(p)
				case "interests":
					@Interests(p)
				default:
					@Profile(p)
			}
		</main>
	}
}

// Profile shows the person as others see them, then lets them edit it.
templ Profile(p Page) {
	<div class="profile-layout">
		<div class="profile-overview">
			<section class="summary-card profile-card" aria-labelledby="profile-name">
				<span class="profile-monogram" aria-hidden="true">{ Initial(p.Account.DisplayName) }</span>
				<div class="profile-identity">
					<p id="profile-name" class="profile-name">{ p.Account.DisplayName }</p>
					if p.Account.Bio != "" {
						<p class="account-bio">{ p.Account.Bio }</p>
					} else if p.Error == "" {
						<p class="field-note">No bio yet.</p>
					}
					if p.Error != "" {
						<p class="field-note">Not saved yet. Your public profile is unchanged.</p>
					}
					<nav class="account-section-jumps" aria-label="Profile actions">
						<a href="#profile-heading" class="text-link">Edit profile</a>
						<a href={ templ.URL("/users/" + p.Account.ID) } class="text-link">View your public profile</a>
					</nav>
				</div>
			</section>
			<section class="profile-activity" aria-labelledby="profile-activity-heading">
				<h2 id="profile-activity-heading">Your public activity</h2>
				if p.ActivityUnavailable {
					<p class="field-note">Your public activity couldn't be loaded right now. Try again shortly.</p>
				} else if len(p.Activity) == 0 {
					<p>Nothing public yet. Recommend an event, or make an Interested choice public, and it appears here and on your public profile.</p>
					<a href="/" class="text-link">Discover events</a>
				} else {
					<ul class="recommendation-list profile-activity-list">
						for _, item := range p.Activity {
							<li class="recommendation-event">
								@home.CollectionEventArt(item.Event, "/me")
								<div class="recommendation-copy">
									@home.CollectionEventHeading(item.Event, "/me")
									if item.Recommended {
										<p class="field-note">You recommended this</p>
									} else {
										<p class="field-note">You're Interested, publicly</p>
									}
								</div>
							</li>
						}
					</ul>
				}
			</section>
		</div>
		<form action="/me/profile" method="post" class="account-form panel profile-editor" aria-labelledby="profile-heading">
			@CSRF(p.CSRF)
			<h2 id="profile-heading">Edit profile</h2>
			<p class="field-note">Your name and bio are public. You don't need to use your real name.</p>
			@label.Label(label.Props{For: "display-name", Class: "field"}) {
				Display name
				@input.Input(input.Props{ID:"display-name",Name:"display_name",Value:p.Account.DisplayName,Required:true,Attributes:templ.Attributes{"maxlength":"80","autocomplete":"nickname"}})
			}
			@label.Label(label.Props{For: "bio", Class: "field"}) {
				Bio <span>(optional, up to 500 characters)</span><textarea id="bio" name="bio" rows="3" maxlength="500">{ p.Account.Bio }</textarea>
			}
			@button.Button(button.Props{Type:button.TypeSubmit,Class:"action"}) {
				Save profile
			}
		</form>
	</div>
}

// Privacy holds every choice about what others see, beside a plain summary.
templ Privacy(p Page) {
	<div class="privacy-layout">
		<form action="/me/privacy" method="post" class="account-form account-panel account-preferences" aria-label="Privacy settings">
			@CSRF(p.CSRF)
			<a href="#privacy-summary-heading" class="text-link privacy-summary-jump">See who can view your activity</a>
			<fieldset class="account-checkboxes notification-preferences">
				<legend>New Interested choices</legend>
				<div class="notification-options">
					<div class="notification-option">
						<label>
							<input type="radio" name="interest_visibility" value="private" aria-labelledby="visibility-private-label" aria-describedby="visibility-private-help" checked?={ p.Account.InterestVisibility != "public" }/>
							<span class="notification-copy">
								<span id="visibility-private-label" class="notification-title">Private</span>
								<span id="visibility-private-help" class="field-note">Counts toward the event's total without naming you.</span>
							</span>
						</label>
					</div>
					<div class="notification-option">
						<label>
							<input type="radio" name="interest_visibility" value="public" aria-labelledby="visibility-public-label" aria-describedby="visibility-public-help" checked?={ p.Account.InterestVisibility == "public" }/>
							<span class="notification-copy">
								<span id="visibility-public-label" class="notification-title">Public</span>
								<span id="visibility-public-help" class="field-note">Shows you on the event, and the event on your profile.</span>
							</span>
						</label>
					</div>
				</div>
				<p class="field-note">Events you already marked keep their setting. Change one on its event page.</p>
			</fieldset>
			<fieldset class="account-fieldset">
				<legend>Name in live activity</legend>
				@label.Label(label.Props{For:"activity-first-name",Class:"field"}) {
					First name <span>(optional)</span>
					@input.Input(input.Props{ID:"activity-first-name",Name:"activity_first_name",Value:activityName(p.Account, ""),Attributes:templ.Attributes{"aria-describedby":"activity-name-help", "autocomplete":"off"}})
				}
				<p id="activity-name-help" class="field-note">Shown publicly in live activity when you recommend an event, even if you turn live activity off in <a href="/me/preferences#live-preferences-heading" class="text-link">Preferences</a>. Leave it blank, and save, to appear as Someone.</p>
				<div class="activity-preview" aria-hidden="true">
					<span class="activity-preview-label">Preview</span>
					<p><strong data-activity-name-preview>{ activityName(p.Account, "Someone") }</strong> recommended an event</p>
				</div>
			</fieldset>
			@button.Button(button.Props{Type:button.TypeSubmit,Class:"action"}) {
				Save privacy
			}
		</form>
		<aside class="summary-card privacy-summary" aria-labelledby="privacy-summary-heading">
			<h2 id="privacy-summary-heading">Who sees what</h2>
			<div class="privacy-summary-group">
				<h3>Anyone</h3>
				<ul>
					<li>Your display name and bio</li>
					<li>Events you made public as Interested</li>
					<li>Your recommendations and their reasons</li>
					<li>Questions, tips and replies you publish</li>
					<li>Your live activity first name, if you set one</li>
				</ul>
			</div>
			<div class="privacy-summary-group">
				<h3>Not public</h3>
				<ul>
					<li>Your email</li>
					<li>Your city, time zone and categories</li>
					<li>Saved events and follows</li>
					<li>Private Interested choices</li>
					<li>Reminders and notification settings</li>
				</ul>
				<p class="field-note">Apps you connect and your API tokens can read some of this, as you allowed.</p>
			</div>
			<a href={ templ.URL("/users/" + p.Account.ID) } class="text-link">View your public profile</a>
		</aside>
	</div>
}

// Security keeps sign-in, connected apps and tokens together, with the
// account-wide sign-out last and behind a confirmation.
templ Security(p Page) {
	<nav class="account-section-jumps" aria-label="On this page">
		if p.ConnectionsEnabled {
			<a href="#connected-apps" class="text-link">Connected apps</a>
		}
		<a href="#api-access" class="text-link">API tokens</a>
		<a href="#all-devices" class="text-link">All devices</a>
	</nav>
	<section class="account-section" aria-labelledby="sign-in-heading">
		<h2 id="sign-in-heading">Sign-in</h2>
		<p>Signed in with Google as <strong class="account-email">{ p.Account.Email }</strong>. Only you can see this email.</p>
		<form action="/auth/logout" method="post">
			@CSRF(p.CSRF)
			@button.Button(button.Props{Type:button.TypeSubmit,Class:"action action-secondary"}) {
				Sign out
			}
		</form>
		<p class="field-note">Signing out of Ticketopia doesn't sign you out of Google.</p>
	</section>
	if p.ConnectionsEnabled {
		@Connections(p)
	}
	<section id="api-access" class="account-section" aria-labelledby="api-tokens-heading">
		<h2 id="api-tokens-heading">API tokens</h2>
		<p>Tokens let your own scripts use your account through the API.</p>
		<a href="/agents#api-tokens" class="text-link">How to use API tokens</a>
		@layouts.SectionNotice(p.notice("tokens"))
		if p.NewToken != "" {
			<div class="account-new-token" data-copy-scope>
				<p class="account-notice" role="status">API token created. Copy it now; it won't be shown again, even if you refresh this page.</p>
				@label.Label(label.Props{For:"new-token",Class:"field"}) {
					Your new API token
				}
				<div class="account-token-controls">
					@input.Input(input.Props{ID:"new-token",Value:p.NewToken,ReadOnly:true,Attributes:templ.Attributes{"autocomplete":"off","spellcheck":"false"}})
					@button.Button(button.Props{Type:button.TypeButton,Class:"action action-secondary",Attributes:templ.Attributes{"data-copy-target":"new-token","hidden":true}}) {
						@layouts.Icon("copy")
						Copy
					}
				</div>
				<p class="field-note" role="status" data-copy-feedback></p>
			</div>
		}
		if len(p.Tokens) == 0 {
			<p class="field-note">You have no active API tokens.</p>
		} else {
			<ul class="account-token-list">
				for _, token := range p.Tokens {
					<li><div><strong>{ token.Name }</strong><p class="field-note">Expires <time datetime={ token.ExpiresAt.Format("2006-01-02T15:04:05Z07:00") }>{ token.ExpiresAt.Format("2 Jan 2006, 15:04 MST") }</time></p></div>
						<form action={ templ.URL("/me/tokens/" + token.ID + "/revoke") } method="post">
							@CSRF(p.CSRF)
							@button.Button(button.Props{Type:button.TypeSubmit,Class:"action action-secondary",Attributes:templ.Attributes{"aria-label":"Revoke " + token.Name}}) {
								Revoke
							}
						</form>
					</li>
				}
			</ul>
		}
		<details class="account-token-details" open?={ p.TokenFormOpen }>
			<summary>Create an API token</summary>
			<form action="/me/tokens" method="post" class="account-form">
				@CSRF(p.CSRF)
				<p id="api-token-warning" class="field-note"><strong>Treat API tokens like passwords.</strong> A token can read your email and private data, change your profile and preferences, make your Interested choices public, and publish, edit or remove posts as you. It expires after 30 days.</p>
				@label.Label(label.Props{For:"token-name",Class:"field"}) {
					Token name
					@input.Input(input.Props{ID:"token-name",Name:"name",Value:p.TokenName,Required:true,Attributes:templ.Attributes{"maxlength":"80"}})
				}
				@button.Button(button.Props{Type:button.TypeSubmit,Class:"action action-secondary",Attributes:templ.Attributes{"aria-describedby":"api-token-warning"}}) {
					Create API token
				}
			</form>
		</details>
	</section>
	<section id="all-devices" class="account-section" aria-labelledby="sign-out-all-heading">
		<h2 id="sign-out-all-heading">All devices</h2>
		<p>Lost a device, or think someone else has access? Sign out everywhere at once.</p>
		@layouts.ConfirmDisclosure("Sign out of all devices") {
			<p>This will:</p>
			<ul id="sign-out-all-effects" class="account-connect-list">
				<li>Sign you out here and on every other device</li>
				<li>Revoke all your API tokens</li>
				if p.ConnectionsEnabled {
					<li>Disconnect every connected app</li>
				}
			</ul>
			<form action="/auth/logout-all" method="post">
				@CSRF(p.CSRF)
				@button.Button(button.Props{Type:button.TypeSubmit,Class:"action action-danger",Attributes:templ.Attributes{"aria-describedby":"sign-out-all-effects"}}) {
					Yes, sign out of all devices
				}
			</form>
		}
	</section>
}

templ Preferences(p Page) {
	<nav class="account-section-jumps" aria-label="On this page">
		<a href="#preferences-heading" class="text-link">Location</a>
		<a href="#notifications" class="text-link">Notifications</a>
		<a href="#categories" class="text-link">Event categories</a>
	</nav>
	<form action="/me/preferences" method="post" class="account-form account-panel account-preferences" aria-labelledby="preferences-heading">
		@CSRF(p.CSRF)
		<h2 id="preferences-heading">Location &amp; time zone</h2>
		<p class="field-note">Used when discovery has no city selected or remembered in this browser. You can always search somewhere else.</p>
		<div class="account-field-grid">
			@label.Label(label.Props{For:"preferred-city",Class:"field"}) {
				City <span>(optional)</span>
				@input.Input(input.Props{ID:"preferred-city",Name:"city",Value:p.Account.Preferences.City,Attributes:templ.Attributes{"maxlength":"120","autocomplete":"address-level2"}})
			}
			@label.Label(label.Props{For:"preferred-country",Class:"field"}) {
				Country <span>(optional, 2-letter code)</span>
				@input.Input(input.Props{ID:"preferred-country",Name:"country",Value:p.Account.Preferences.Country,Attributes:templ.Attributes{"maxlength":"2","pattern":"[A-Za-z]{2}","autocomplete":"country","autocapitalize":"characters"}})
			}
		</div>
		@label.Label(label.Props{For:"timezone",Class:"field"}) {
			Time zone
			@input.Input(input.Props{ID:"timezone",Name:"timezone",Value:p.Account.Preferences.Timezone,Required:true,Attributes:templ.Attributes{"maxlength":"64","aria-describedby":"timezone-help"}})
		}
		<p id="timezone-help" class="field-note">For example America/Chicago or Europe/Berlin. Reminder times use this zone; event dates use the venue's.</p>
		<fieldset id="notifications" class="account-checkboxes notification-preferences"><legend>Notifications</legend>
			<div class="notification-options">
				<div class="notification-option">
					<label>
						<input type="checkbox" name="email_reminders" aria-labelledby="email-reminders-label" aria-describedby="email-reminders-help" checked?={ p.Account.Preferences.EmailReminders }/>
						<span class="notification-copy">
							<span id="email-reminders-label" class="notification-title">Email me on-sale reminders</span>
							<span id="email-reminders-help" class="field-note">For saved events you choose. Saving alone won’t send email.</span>
						</span>
					</label>
					<a href="/me/reminders" class="text-link notification-settings-link">Choose events &amp; timing</a>
				</div>
				<div class="notification-option">
					<label>
						<input type="checkbox" name="notifications_paused" aria-labelledby="notification-pause-label" aria-describedby="notification-pause-help" checked?={ p.Account.Preferences.NotificationsPaused }/>
						<span class="notification-copy">
							<span id="notification-pause-label" class="notification-title">Pause all notifications</span>
							<span id="notification-pause-help" class="field-note">Stops live activity, on-sale emails and reply updates across your account. Uncheck to resume your configured notifications.</span>
						</span>
					</label>
				</div>
			</div>
			<div class="notification-replies">
				<h3>Replies in the app</h3>
				<p class="field-note">Updates from conversations you follow. These stay in Ticketopia, not email.</p>
				<div class="notification-links">
					<a href="/me/discussions" class="text-link">Choose reply frequency</a>
					<a href="/me/notifications" class="text-link">Read reply updates</a>
				</div>
			</div>
			<details class="account-more notification-delivery">
				<summary>About email delivery</summary>
				<p class="field-note">Reminders go to your account email when delivery is enabled on this server. Missed reminders may expire while paused.</p>
			</details>
		</fieldset>
		@button.Button(button.Props{Type:button.TypeSubmit,Class:"action"}) {
			Save preferences
		}
	</form>
	<form id="categories" action="/me/preferences" method="post" class="account-form account-panel account-preferences account-section" aria-labelledby="categories-heading">
		@CSRF(p.CSRF)<input type="hidden" name="section" value="categories"/>
		<h2 id="categories-heading">Event categories</h2>
		<p class="field-note">Categories you enjoy help explain matches in <a href="/radar" class="text-link">your Radar</a>. They're private, and discovery still shows every category.</p>
		@layouts.SectionNotice(p.notice("categories"))
		if p.CategoriesUnavailable {
			<p class="account-notice" role="status">Category options couldn't be refreshed. Existing choices are retained below; try this page again shortly for the complete catalog.</p>
		}
		<fieldset class="account-checkboxes account-category-grid"><legend class="sr-only">Event categories</legend>
			for _, category := range p.Categories {
				<label><input type="checkbox" name="category_ids" value={ category.ID } checked?={ p.Selected(category.ID) }/><span>{ category.Name }</span></label>
			}
			for _, id := range p.MissingCategories() {
				<label><input type="checkbox" name="category_ids" value={ id } checked/><span>Previously selected category: { id }</span></label>
			}
			if len(p.Categories) == 0 && len(p.Account.Preferences.CategoryIDs) == 0 {
				<p class="field-note">No category options are available right now.</p>
			}
		</fieldset>
		@button.Button(button.Props{Type:button.TypeSubmit,Class:"action"}) {
			Save categories
		}
	</form>
	if p.LivePreferences != nil {
		<form action="/me/live-activity-preferences" method="post" class="account-form account-panel account-preferences account-section" aria-labelledby="live-preferences-heading">
			@CSRF(p.CSRF)
			<input type="hidden" name="revision" value={ fmt.Sprint(p.LivePreferences.Revision) }/>
			<h2 id="live-preferences-heading">Live activity</h2>
			@layouts.SectionNotice(p.notice("live"))
			<p class="field-note">New public recommendations appear as top-right toasts. Browse and filter recent activity in <a class="text-link" href="/happening-now">Happening Now</a>. Choose the name you appear under in <a class="text-link" href="/me/privacy">Privacy</a>.</p>
			<div class="account-checkboxes notification-preferences">
				<div class="notification-option"><label>
					<input type="checkbox" name="enabled" aria-labelledby="live-enabled-label" aria-describedby="live-enabled-help" checked?={ p.LivePreferences.Enabled }/>
					<span class="notification-copy">
						<span id="live-enabled-label" class="notification-title">Enable live activity</span>
						<span id="live-enabled-help" class="field-note">Turn off just this feed without pausing replies or email reminders. Pause all notifications overrides this.</span>
					</span>
				</label></div>
			</div>
			@layouts.LiveFilterFields(p.LivePreferences.Filters, p.Categories, p.LiveEditor)
			@button.Button(button.Props{Type:button.TypeSubmit,Class:"action"}) { Save live activity }
		</form>
	}
}

templ Interests(p Page) {
	@home.InterestCollection(p.EventInterests)
	<p class="field-note account-aside-note">Choose the event categories you enjoy in <a href="/me/preferences#categories" class="text-link">Preferences</a>.</p>
}

templ Public(p accounts.PublicProfile, list interests.List, returnURL string, message string, recommended recommendations.List, recommendationError string) {
	@layouts.App("profile", p.DisplayName) {
		<main id="main" class="destination-page account-page">
			// The same card the owner sees at the top of /me.
			<section class="summary-card profile-card account-public" aria-labelledby="public-name">
				<span class="profile-monogram" aria-hidden="true">{ Initial(p.DisplayName) }</span>
				<div class="profile-identity">
					<h1 id="public-name" class="profile-name">{ p.DisplayName }</h1>
					if p.Bio != "" {
						<p class="account-bio">{ p.Bio }</p>
					} else {
						<p class="intro">No bio added.</p>
					}
					<p class="field-note">Public profile. Email, location, saves, private interest, and personal preferences are private.</p>
					<a href="/" class="text-link">Discover events</a>
				</div>
			</section>
			if message != "" {
				<p class="field-note" role="status">{ message }</p>
			} else {
				@home.PublicInterestEvents(list, returnURL)
			}
			@home.PublicRecommendationEvents(recommended,returnURL,recommendationError)
		</main>
	}
}
