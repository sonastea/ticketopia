package account

import "net/url"
import "fmt"
import "github.com/sonastea/ticketopia/internal/accounts"
import "github.com/sonastea/ticketopia/internal/interests"
import "github.com/sonastea/ticketopia/internal/recommendations"
import "github.com/sonastea/ticketopia/views/home"
import "github.com/sonastea/ticketopia/views/layouts"
import "github.com/sonastea/ticketopia/views/components/button"
import "github.com/sonastea/ticketopia/views/components/input"
import "github.com/sonastea/ticketopia/views/components/label"
import "github.com/sonastea/ticketopia/views/components/alert"
import selectcomp "github.com/sonastea/ticketopia/views/components/select"

templ SignIn(enabled bool, returnTo string, message string) {
	@SignInContext(enabled, returnTo, message, "", "")
}

// intent is "save" when sign-in will complete a Save the visitor already chose.
templ SignInContext(enabled bool, returnTo string, message string, eventName string, intent string) {
	@layouts.App("profile", "Sign in") {
		<main id="main" class="destination-page account-page">
			<div class="account-sign-in">
				<h1>Your event life, your space.</h1>
				if message != "" {
					<p role="status" class="account-notice">{ message }</p>
				}
				if section := signInSection(returnTo); section != "" {
					if eventName != "" {
						<h2>{ eventName }</h2>
					}
					if intent == "save" {
						<p>After sign-in, we'll save this event to your private Saved list and return you to its { section } section.</p>
						<p class="field-note">Signing in doesn't mark interest, publish a recommendation, change visibility, or set up reminders.</p>
					} else {
						<p>After sign-in, you'll return to this event's { section } section. Choose your action there.</p>
						<p class="field-note">Signing in doesn't save an event, mark interest, publish a recommendation, change visibility, or set up reminders.</p>
					}
				}
				if enabled {
					<p>Sign in to create your Ticketopia profile and keep your preferences across visits and devices.</p>
					@button.Button(button.Props{Href: googleStartURL(returnTo, intent), Class: "google-sign-in"}) {
						<span class="google-sign-in-logo" aria-hidden="true">
							<img src="/assets/google-g.png" width="20" height="20" alt="" aria-hidden="true"/>
						</span>
						<span>Sign in with Google</span>
					}
					<p class="field-note">Google handles sign-in. Ticketopia never receives your Google password. We only request your account identity and email—not your contacts, calendar, or Gmail.</p>
					<p class="field-note">Your email and preferences stay private. Your display name and bio are public; you can choose a name that isn't your real name.</p>
				} else {
					<p>Accounts aren't enabled on this server. You can still discover events without signing in.</p>
				}
				<a href={ templ.URL(signInBackURL(returnTo)) } class="text-link">{ signInBackLabel(returnTo) }</a>
			</div>
		</main>
	}
}

templ Failure(message string) {
	@layouts.App("profile", "Account request couldn't finish") {
		<main id="main" class="destination-page account-page">
			@alert.Alert(alert.Props{Class: "feedback error-state", Variant: alert.VariantDestructive}) {
				<h1>Account request couldn't finish</h1><p>{ message }</p>
				<a href="/me" class="text-link">Return to your profile</a>
				<a href="/auth/sign-in" class="text-link">Start sign-in again</a>
			}
			<a href="/" class="text-link">Discover events without signing in</a>
		</main>
	}
}

// Task failures keep native recovery in the event journey, not the account area.
templ EventTaskFailure(message string, returnURL string, signIn bool) {
	@layouts.App("discover", "Event request couldn't finish") {
		<main id="main" class="destination-page account-page">
			@alert.Alert(alert.Props{Class: "feedback error-state", Variant: alert.VariantDestructive}) {
				<h1>Event request couldn't finish</h1><p>{ message }</p>
				<p>Return to the event or collection to check its current state, then try again.</p>
				<div class="account-actions">
					<a href={ templ.URL(returnURL) } class="text-link">Return and try again</a>
					if signIn {
						<a href={ templ.URL("/auth/sign-in?return_to=" + url.QueryEscape(returnURL)) } class="text-link">Sign in to continue here</a>
					}
				</div>
			}
		</main>
	}
}

templ CSRF(token string) {
	<input type="hidden" name="csrf_token" value={ token }/>
}

templ Settings(p Page) {
	@layouts.App(p.Active(), p.Title()) {
		<main id="main" class="destination-page account-page">
			<header class="account-heading"><h1>{ p.Title() }</h1><p class="intro">Make this space feel like yours. Your email and preferences stay private.</p></header>
			@layouts.AccountNav(p.Section, layouts.AccountNavPermissions{ModerationEnabled:p.ModerationEnabled,Moderator:p.Moderator})
			if p.Error != "" {
				@alert.Alert(alert.Props{Class: "feedback error-state", Variant: alert.VariantDestructive}) {
					<h2>Changes weren't saved</h2><p>{ p.Error }</p>
				}
			}
			if p.Notice != "" {
				<p class="account-notice" role="status">{ p.Notice }</p>
			}
			switch p.Section {
				case "preferences":
					@Preferences(p)
				case "interests":
					@Interests(p)
				default:
					@Profile(p)
			}
		</main>
	}
}

templ Profile(p Page) {
	<div class="account-profile-layout">
		<form action="/me/profile" method="post" class="account-form" aria-labelledby="profile-heading">
			@CSRF(p.CSRF)
			<h2 id="profile-heading">Your public profile</h2>
			<p class="field-note">Your display name and bio are visible to anyone with your profile link. You don't need to use your real name.</p>
			@label.Label(label.Props{For: "display-name", Class: "field"}) {
				Display name
				@input.Input(input.Props{ID:"display-name",Name:"display_name",Value:p.Account.DisplayName,Required:true,Attributes:templ.Attributes{"maxlength":"80","autocomplete":"nickname"}})
			}
			@label.Label(label.Props{For: "bio", Class: "field"}) {
				Bio <span>(optional, up to 500 characters)</span><textarea id="bio" name="bio" rows="4" maxlength="500">{ p.Account.Bio }</textarea>
			}
			<h2>Live activity attribution</h2>
			@label.Label(label.Props{For:"activity-first-name",Class:"field"}) {
				First name for live activity (optional)
				@input.Input(input.Props{ID:"activity-first-name",Name:"activity_first_name",Value:activityName(p.Account, ""),Attributes:templ.Attributes{"aria-describedby":"activity-name-help", "autocomplete":"off"}})
			}
			<p id="activity-name-help" class="field-note">Live recommendations show this first name. Leave it blank to appear as Someone. Your email and last name are not included in live notifications.</p>
			<p class="field-note">Live activity preview: <span data-activity-name-preview>{ activityName(p.Account, "Someone") }</span> recommended an event.</p>
			<h2>Interest privacy</h2>
			@label.Label(label.Props{For:"interest-visibility",Class:"field"}) {
				Default visibility for event interest
				@selectcomp.Native(selectcomp.NativeProps{ID:"interest-visibility",Name:"interest_visibility",Attributes:templ.Attributes{"aria-describedby":"interest-privacy-help"}}) {
					<option value="private" selected?={ p.Account.InterestVisibility != "public" }>Private</option>
					<option value="public" selected?={ p.Account.InterestVisibility == "public" }>Public</option>
				}
			}
			<p id="interest-privacy-help" class="field-note">Applies only to new event interest. Changing this default does not change existing choices. Private interest contributes to counts without naming you; Public shows your profile on the event and the event on your profile. You can change each event's visibility separately.</p>
			@button.Button(button.Props{Type:button.TypeSubmit,Class:"action"}) {
				Save profile &amp; privacy
			}
		</form>
		<aside class="account-preview" aria-labelledby="public-preview-heading">
			<h2 id="public-preview-heading">What others can see</h2>
			if p.Error != "" {
				<p class="field-note">The changes shown here haven't been saved. Your public profile is unchanged.</p>
			}
			<p class="account-display-name">{ p.Account.DisplayName }</p>
			if p.Account.Bio != "" {
				<p class="account-bio">{ p.Account.Bio }</p>
			} else {
				<p class="field-note">No bio added.</p>
			}
			<a href={ templ.URL("/users/" + p.Account.ID) } class="text-link">Open your public profile</a>
			<p class="field-note">Your email, city, category preferences, notification settings, saves, follows, and private event interest are not part of this public view. Public event interest and separately published recommendations appear.</p>
		</aside>
	</div>
	<section class="account-section" aria-labelledby="sign-in-heading">
		<h2 id="sign-in-heading">Sign-in &amp; security</h2>
		<p>Signed in with Google as <strong class="account-email">{ p.Account.Email }</strong>.</p>
		<p class="field-note">Only you can see this email here. Signing out of Ticketopia does not sign you out of Google.</p>
		<div class="account-actions">
			<form action="/auth/logout" method="post">
				@CSRF(p.CSRF)
				@button.Button(button.Props{Type:button.TypeSubmit,Class:"action action-secondary"}) {
					Sign out
				}
			</form>
			<form action="/auth/logout-all" method="post">
				@CSRF(p.CSRF)
				@button.Button(button.Props{Type:button.TypeSubmit,Class:"action action-secondary"}) {
					Sign out everywhere &amp; revoke API tokens
				}
			</form>
		</div>
		<details class="account-token-details" open?={ p.NewToken != "" }>
			<summary>API access <span class="field-note">For your own apps and scripts</span></summary>
			<p class="field-note">API tokens can read and change your profile and private preferences. They expire after 30 days and cannot create other tokens. Treat them like passwords.</p>
			if p.NewToken != "" {
				@label.Label(label.Props{For:"new-token",Class:"field"}) {
					Copy your new API token now
					@input.Input(input.Props{ID:"new-token",Value:p.NewToken,ReadOnly:true,Attributes:templ.Attributes{"autocomplete":"off","spellcheck":"false"}})
				}
			}
			<form action="/me/tokens" method="post" class="account-form">
				@CSRF(p.CSRF)
				@label.Label(label.Props{For:"token-name",Class:"field"}) {
					Token name
					@input.Input(input.Props{ID:"token-name",Name:"name",Required:true,Attributes:templ.Attributes{"maxlength":"80"}})
				}
				@button.Button(button.Props{Type:button.TypeSubmit,Class:"action action-secondary"}) {
					Create API token
				}
			</form>
			if len(p.Tokens) == 0 {
				<p class="field-note">You have no active API tokens.</p>
			} else {
				<ul class="account-token-list">
					for _, token := range p.Tokens {
						<li><div><strong>{ token.Name }</strong><p class="field-note">Expires <time datetime={ token.ExpiresAt.Format("2006-01-02T15:04:05Z07:00") }>{ token.ExpiresAt.Format("2 Jan 2006, 15:04 MST") }</time></p></div>
							<form action={ templ.URL("/me/tokens/" + token.ID + "/revoke") } method="post">
								@CSRF(p.CSRF)
								@button.Button(button.Props{Type:button.TypeSubmit,Class:"action action-secondary",Attributes:templ.Attributes{"aria-label":"Revoke " + token.Name}}) {
									Revoke
								}
							</form>
						</li>
					}
				</ul>
			}
		</details>
	</section>
}

templ Preferences(p Page) {
	<form action="/me/preferences" method="post" class="account-form account-preferences" aria-labelledby="preferences-heading">
		@CSRF(p.CSRF)
		<h2 id="preferences-heading">Location &amp; time zone</h2>
		<p class="field-note">Used when discovery has no city selected or remembered in this browser. You can always search somewhere else.</p>
		<div class="account-field-grid">
			@label.Label(label.Props{For:"preferred-city",Class:"field"}) {
				City <span>(optional)</span>
				@input.Input(input.Props{ID:"preferred-city",Name:"city",Value:p.Account.Preferences.City,Attributes:templ.Attributes{"maxlength":"120","autocomplete":"address-level2"}})
			}
			@label.Label(label.Props{For:"preferred-country",Class:"field"}) {
				Country <span>(optional, 2-letter code)</span>
				@input.Input(input.Props{ID:"preferred-country",Name:"country",Value:p.Account.Preferences.Country,Attributes:templ.Attributes{"maxlength":"2","pattern":"[A-Za-z]{2}","autocomplete":"country"}})
			}
		</div>
		@label.Label(label.Props{For:"timezone",Class:"field"}) {
			Time zone
			@input.Input(input.Props{ID:"timezone",Name:"timezone",Value:p.Account.Preferences.Timezone,Required:true,Attributes:templ.Attributes{"maxlength":"64","aria-describedby":"timezone-help"}})
		}
		<p id="timezone-help" class="field-note">Use an IANA time zone such as America/Chicago or Europe/Berlin. Reminder times use this zone; event dates still use the venue's time zone.</p>
		<fieldset class="account-checkboxes notification-preferences"><legend>Notifications</legend>
			<div class="notification-options">
				<div class="notification-option">
					<label>
						<input type="checkbox" name="email_reminders" aria-labelledby="email-reminders-label" aria-describedby="email-reminders-help" checked?={ p.Account.Preferences.EmailReminders }/>
						<span class="notification-copy">
							<span id="email-reminders-label" class="notification-title">Email me on-sale reminders</span>
							<span id="email-reminders-help" class="field-note">For saved events you choose. Saving alone won’t send email.</span>
						</span>
					</label>
					<a href="/me/reminders" class="text-link notification-settings-link">Choose events &amp; timing</a>
				</div>
				<div class="notification-option">
					<label>
						<input type="checkbox" name="notifications_paused" aria-labelledby="notification-pause-label" aria-describedby="notification-pause-help" checked?={ p.Account.Preferences.NotificationsPaused }/>
						<span class="notification-copy">
							<span id="notification-pause-label" class="notification-title">Pause all notifications</span>
							<span id="notification-pause-help" class="field-note">Stops live activity, on-sale emails and reply updates across your account. Uncheck to resume your configured notifications.</span>
						</span>
					</label>
				</div>
			</div>
			<div class="notification-replies">
				<h3>Replies in the app</h3>
				<p class="field-note">Updates from conversations you follow. These stay in Ticketopia, not email.</p>
				<div class="notification-links">
					<a href="/me/discussions" class="text-link">Choose reply frequency</a>
					<a href="/me/notifications" class="text-link">Read reply updates</a>
				</div>
			</div>
			<details class="account-more notification-delivery">
				<summary>About email delivery</summary>
				<p class="field-note">Reminders go to your account email when delivery is enabled on this server. Missed reminders may expire while paused.</p>
			</details>
		</fieldset>
		@button.Button(button.Props{Type:button.TypeSubmit,Class:"action"}) {
			Save preferences
		}
	</form>
	if p.LivePreferences != nil {
		<form action="/me/live-activity-preferences" method="post" class="account-form account-preferences account-section" aria-labelledby="live-preferences-heading">
			@CSRF(p.CSRF)
			<input type="hidden" name="revision" value={ fmt.Sprint(p.LivePreferences.Revision) }/>
			<h2 id="live-preferences-heading">Live activity</h2>
			<p class="field-note">Notifications start enabled. New public recommendations appear as top-right toasts. Browse recent activity and filter both views in <a class="text-link" href="/happening-now">Happening Now</a>.</p>
			<div class="account-checkboxes notification-preferences">
				<div class="notification-option"><label>
					<input type="checkbox" name="enabled" aria-labelledby="live-enabled-label" aria-describedby="live-enabled-help" checked?={ p.LivePreferences.Enabled }/>
					<span class="notification-copy">
						<span id="live-enabled-label" class="notification-title">Enable live activity</span>
						<span id="live-enabled-help" class="field-note">Turn off just this feed without pausing replies or email reminders.</span>
					</span>
				</label></div>
			</div>
			<p class="field-note">Pause all notifications overrides this choice. Hide activity toasts on Happening Now hides automatic notifications only in that browser; you can still browse that page.</p>
			@layouts.LiveFilterFields(p.LivePreferences.Filters, p.Categories, p.LiveEditor)
			@button.Button(button.Props{Type:button.TypeSubmit,Class:"action"}) { Save live activity }
		</form>
	}
}

templ Interests(p Page) {
	@home.InterestCollection(p.EventInterests)
	<form action="/me/preferences" method="post" class="account-form account-preferences" aria-labelledby="interests-heading">
		@CSRF(p.CSRF)<input type="hidden" name="section" value="interests"/>
		<h2 id="interests-heading">What catches your interest?</h2>
		<p>Choose categories you enjoy. These preferences stay private and are separate from marking an individual event Interested.</p>
		<p class="field-note">Category choices help explain matches in <a href="/radar" class="text-link">your private Radar</a>. Discovery still lets you explore every category.</p>
		if p.CategoriesUnavailable {
			<p class="account-notice" role="status">Category options couldn't be refreshed. Existing choices are retained below; try this page again shortly for the complete catalog.</p>
		}
		<fieldset class="account-checkboxes"><legend>Event categories</legend>
			for _, category := range p.Categories {
				<label><input type="checkbox" name="category_ids" value={ category.ID } checked?={ p.Selected(category.ID) }/><span>{ category.Name }</span></label>
			}
			for _, id := range p.MissingCategories() {
				<label><input type="checkbox" name="category_ids" value={ id } checked/><span>Previously selected category: { id }</span></label>
			}
			if len(p.Categories) == 0 && len(p.Account.Preferences.CategoryIDs) == 0 {
				<p class="field-note">No category options are available right now.</p>
			}
		</fieldset>
		@button.Button(button.Props{Type:button.TypeSubmit,Class:"action"}) {
			Save category preferences
		}
	</form>
}

templ Public(p accounts.PublicProfile, list interests.List, returnURL string, message string, recommended recommendations.List, recommendationError string) {
	@layouts.App("profile", p.DisplayName) {
		<main id="main" class="destination-page account-page">
			<div class="account-public"><h1>{ p.DisplayName }</h1>
				if p.Bio != "" {
					<p class="account-bio">{ p.Bio }</p>
				} else {
					<p class="intro">No bio added.</p>
				}
				<p class="field-note">Public profile. Email, location, saves, private interest, and personal preferences are private.</p>
				<a href="/" class="text-link">Discover events</a>
			</div>
			if message != "" {
				<p class="field-note" role="status">{ message }</p>
			} else {
				@home.PublicInterestEvents(list, returnURL)
			}
			@home.PublicRecommendationEvents(recommended,returnURL,recommendationError)
		</main>
	}
}
