package account

import "github.com/sonastea/ticketopia/internal/reminders"
import "github.com/sonastea/ticketopia/views/layouts"
import "github.com/sonastea/ticketopia/views/components/button"
import "github.com/sonastea/ticketopia/views/components/input"
import "github.com/sonastea/ticketopia/views/components/label"
import selectcomp "github.com/sonastea/ticketopia/views/components/select"

templ Reminders(p ReminderPage) {
	@layouts.App("profile", "On-sale reminders") {
		<main id="main" class="destination-page account-page reminders-page">
			<h1>On-sale reminders</h1>
			<p class="intro">Private emails for public ticket sales you choose to remember. Saving an event does not turn reminders on.</p>
			<nav class="account-nav" aria-label="Reminder navigation"><a href="/saved">Saved events</a><a href="/me/reminders">Your reminders</a><a href="/me/preferences">Email &amp; pause preferences</a></nav>
			if !p.Enabled {
				<p>Email reminders are not enabled on this server. Your saved events are unchanged.</p>
			} else {
				if p.Notice != "" {
					<p class="reminder-confirmation" role="status">{ p.Notice }</p>
				}
				if p.Account.Preferences.NotificationsPaused || !p.Account.Preferences.EmailReminders {
					<p class="account-notice" role="status">Delivery is paused by email permission or global pause. Review <a href="/me/preferences" class="text-link">Preferences</a> to allow eligible sends. Saving timing does not change those choices.</p>
				}
				if p.Event != nil {
					<section class="reminder-detail" aria-labelledby="reminder-event-heading">
						<h2 id="reminder-event-heading">{ p.Event.Name }</h2>
						<a href={ templ.URL("/events/"+p.Event.ID+"?section=overview") } class="text-link">Event Overview</a>
						<p class="tabular-nums"><strong>Public ticket sale:</strong> { p.SaleTime() }</p>
						<p class="field-note">This is the ticket-sale time, not the event date. Times below use your account time zone: { p.Zone() }.</p>
						if p.Own != nil {
							<p><strong>Saved timing:</strong> { reminderLead(p.Own.LeadMinutes) } before public sale.</p>
							@ReminderReadiness(*p.Own)
							<p class="tabular-nums"><strong>Reminder target:</strong> { p.Time(p.Own.ScheduledAt) }</p>
						} else {
							<p><strong>Not configured.</strong> Choose a lead time and save to set up this reminder.</p>
						}
					</section>
					<form method="post" action={ templ.URL(reminderURL(p.Event.ID)) } class="account-form" novalidate data-reminder-timing data-sale-at={ p.SaleISO() } data-timezone={ p.Zone() } data-event-status={ p.Event.Status }>
						@CSRF(p.CSRF)<input type="hidden" name="action" value="set"/>
						<div class="field">
							@label.Label(label.Props{For:"reminder-timing"}) { Remind me before public sale }
							@selectcomp.Native(selectcomp.NativeProps{ID:"reminder-timing",Name:"timing",Attributes:templ.Attributes{"required":true,"aria-describedby":"reminder-help reminder-error"}}) {
								if p.Submitted && p.TimingChoice() != "30" && p.TimingChoice() != "60" && p.TimingChoice() != "1440" && p.TimingChoice() != "custom" {
									<option value={ p.Choice } selected>Choose a lead time</option>
								}
								<option value="30" selected?={ p.TimingChoice() == "30" }>30 minutes</option>
								<option value="60" selected?={ p.TimingChoice() == "60" }>1 hour</option>
								<option value="1440" selected?={ p.TimingChoice() == "1440" }>1 day</option>
								<option value="custom" selected?={ p.TimingChoice() == "custom" }>Custom</option>
							}
						</div>
						@label.Label(label.Props{For:"reminder-lead",Class:"field reminder-custom"}) {
							Custom lead time in minutes
							@input.Input(input.Props{ID:"reminder-lead",Name:"lead_minutes",Type:"number",Value:p.CustomValue(),Attributes:templ.Attributes{"min":"1","max":"10080","step":"1","aria-describedby":"reminder-help reminder-error"}})
						}
						<p id="reminder-help" class="field-note">Custom uses 1–10080 whole minutes (up to seven days), only when Custom is selected. Saving does not grant email permission or turn off global pause. No ticket reservation or availability is guaranteed.</p>
						<p id="reminder-error" class="reminder-error" role="alert" hidden?={ p.Error == "" }>{ p.Error }</p>
						<div class="reminder-preview"><strong>Timing preview</strong><p data-reminder-preview aria-live="polite" class="tabular-nums">{ p.Preview() }</p></div>
						@button.Button(button.Props{Type:button.TypeSubmit,Class:"action"}) { Save email reminder }
					</form>
					if p.Own != nil {
						<form method="post" action={ templ.URL(reminderURL(p.Event.ID)) } class="account-actions">
							@CSRF(p.CSRF)<input type="hidden" name="action" value="stop"/>
							@button.Button(button.Props{Type:button.TypeSubmit,Variant:button.VariantOutline,Class:"action action-secondary"}) { Stop this reminder }
						</form>
					}
				} else if len(p.List.Items)==0 {
					<h2>No on-sale reminders yet.</h2><p>Open a saved event's On-sale reminder link to choose when to receive an email.</p>
					@button.Button(button.Props{Href:"/saved",Class:"action"}) { Choose a saved event }
				} else {
					<ul class="reminder-list">
						for _, item := range p.List.Items {
							<li><h2><a href={ templ.URL(reminderURL(item.EventID)) } class="text-link">{ item.Name }</a></h2><p class="tabular-nums"><strong>Reminder target:</strong> { p.Time(item.ScheduledAt) }</p>@ReminderReadiness(item)</li>
						}
					</ul>
					if p.List.NextCursor != nil {
						@button.Button(button.Props{Href:p.Next(),Variant:button.VariantOutline,Class:"action action-secondary"}) { More reminders }
					}
				}
				<p class="field-note">Removing an event from Saved stops its reminder. A message already being sent cannot be recalled. Meaningful change emails and weekly digests are not delivered yet.</p>
			}
		</main>
	}
}

templ ReminderReadiness(item reminders.Item) {
	<p><strong>{ reminderState(item.State) }</strong></p>
	<p class="field-note">{ reminderStateDetail(item.State) }</p>
}

templ ReminderUnsubscribe(token string, done bool) {
	@layouts.App("profile", "Stop an on-sale reminder") {
		<main id="main" class="destination-page account-page reminders-page">
			<h1>Stop an on-sale reminder</h1>
			if done {
				<p role="status">This reminder is stopped. Your other reminders and saved events are unchanged.</p>
			} else {
				<p>Stop future on-sale emails for this event. No sign-in is needed.</p>
				<form method="post" action={ templ.URL("/reminders/unsubscribe/"+token) }>
					@button.Button(button.Props{Type:button.TypeSubmit}) { Stop this reminder }
				</form>
			}
			<a href="/me/reminders" class="text-link">Manage your reminders</a>
		</main>
	}
}
