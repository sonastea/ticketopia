package account

import "github.com/sonastea/ticketopia/internal/oauth"
import "github.com/sonastea/ticketopia/views/layouts"
import "github.com/sonastea/ticketopia/views/components/button"
import "github.com/sonastea/ticketopia/views/components/alert"

// Consent asks whether an agent may use the signed-in account. The app is
// named by the hostname serving its metadata, since no one reviewed it.
templ Consent(p ConsentPage) {
	@layouts.App("profile", "Connect "+p.ClientName) {
		<main id="main" class="destination-page account-page">
			<div class="account-sign-in account-connect">
				<h1>Connect { p.ClientName } to Ticketopia?</h1>
				<p>This app is published by <strong class="account-connect-host">{ p.ClientHost }</strong>. Only continue if you started connecting from that app just now.</p>
				<p class="field-note">Signed in as <strong class="account-email">{ p.Email }</strong>.</p>
				<form action={ templ.URL(p.Action) } method="post" class="account-form">
					@CSRF(p.CSRF)
					for _, field := range p.Fields {
						<input type="hidden" name={ field.Name } value={ field.Value }/>
					}
					<h2>What it can do</h2>
					<ul class="account-connect-list">
						<li>Search events and read their details</li>
						<li>Read your saved events and on-sale reminders</li>
					</ul>
					if p.Write {
						<div class="account-checkboxes">
							<label>
								<input type="checkbox" name="write" checked aria-labelledby="connect-write-label" aria-describedby="connect-write-help"/>
								<span class="notification-copy">
									<span id="connect-write-label" class="notification-title">Also allow changes</span>
									<span id="connect-write-help" class="field-note">Save and remove events, and set or stop on-sale reminders. Leave this off for read-only access.</span>
								</span>
							</label>
						</div>
					}
					<p class="field-note">It can't see your email, change your profile or preferences, or post anything publicly. It stays connected until you disconnect it on your profile page, or after 30 days without use.</p>
					<div class="account-actions">
						@button.Button(button.Props{Type: button.TypeSubmit, Class: "action", Attributes: templ.Attributes{"name": "decision", "value": "allow"}}) {
							Connect
						}
						@button.Button(button.Props{Type: button.TypeSubmit, Class: "action action-secondary", Attributes: templ.Attributes{"name": "decision", "value": "deny"}}) {
							Cancel
						}
					</div>
					if p.LocalRedirect {
						<p class="field-note">Either way, you'll return to the app on this device.</p>
					} else {
						<p class="field-note">Either way, you'll return to <span class="account-connect-host">{ p.RedirectHost }</span>.</p>
					}
				</form>
			</div>
		</main>
	}
}

// ConnectFailure explains a connection request that can't safely return to its app.
templ ConnectFailure(message string) {
	@layouts.App("profile", "App connection couldn't start") {
		<main id="main" class="destination-page account-page">
			@alert.Alert(alert.Props{Class: "feedback error-state", Variant: alert.VariantDestructive}) {
				<h1>App connection couldn't start</h1><p>{ message }</p>
				<p>Nothing was connected to your account.</p>
				<a href="/me" class="text-link">Go to your profile</a>
			}
			<a href="/" class="text-link">Discover events</a>
		</main>
	}
}

// Connections lists agents signed in through OAuth, each revocable.
templ Connections(p Page) {
	<details class="account-token-details" open?={ p.ConnectionsOpen }>
		<summary>Connected apps <span class="field-note">AI agents you signed in to Ticketopia</span></summary>
		<p class="field-note">Connected apps can search events and use your saved events and reminders. Disconnecting stops them immediately.</p>
		if len(p.Connections) == 0 {
			<p class="field-note">You have no connected apps.</p>
		} else {
			<ul class="account-token-list">
				for _, connection := range p.Connections {
					@connectionItem(p, connection)
				}
			</ul>
		}
	</details>
}

templ connectionItem(p Page, connection oauth.Grant) {
	<li>
		<div>
			<strong>{ connection.ClientName }</strong>
			<p class="field-note">
				<span class="account-connect-host">{ connection.Host() }</span> ·
				if connection.Write() {
					Can make changes
				} else {
					Read-only
				}
			</p>
			<p class="field-note">Connected <time datetime={ connection.CreatedAt.Format("2006-01-02T15:04:05Z07:00") }>{ connection.CreatedAt.Format("2 Jan 2006") }</time></p>
		</div>
		<form action={ templ.URL("/me/connections/" + connection.ID + "/revoke") } method="post">
			@CSRF(p.CSRF)
			@button.Button(button.Props{Type: button.TypeSubmit, Class: "action action-secondary", Attributes: templ.Attributes{"aria-label": "Disconnect " + connection.ClientName}}) {
				Disconnect
			}
		</form>
	</li>
}
