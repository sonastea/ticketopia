package account

import "github.com/sonastea/ticketopia/internal/oauth"
import "github.com/sonastea/ticketopia/views/layouts"
import "github.com/sonastea/ticketopia/views/components/button"

// Consent asks whether an agent may use the signed-in account. The app is
// named by the hostname serving its metadata, since no one reviewed it.
templ Consent(p ConsentPage) {
	@layouts.App("profile", "Connect "+p.ClientName) {
		<main id="main" class="destination-page account-page">
			<div class="account-sign-in account-connect">
				<h1>Connect { p.ClientName } to Ticketopia?</h1>
				<p>This app is published by <strong class="account-connect-host">{ p.ClientHost }</strong>. Only continue if you started connecting from that app just now.</p>
				<p>Signed in as <strong class="account-email">{ p.Email }</strong>.</p>
				<form action={ templ.URL(p.Action) } method="post" class="account-form">
					@CSRF(p.CSRF)
					for _, field := range p.Fields {
						<input type="hidden" name={ field.Name } value={ field.Value }/>
					}
					<fieldset class="account-checkboxes connect-permissions">
						<legend>What this app can do</legend>
						<p><strong>Read account data</strong> <span class="field-note">Included</span><br/>Search events and read your radar, saved events, reminders, follows, public activity, preferences and pending drafts.</p>
							if p.Write {
								<label>
									<input type="checkbox" name="write" aria-labelledby="connect-write-label" aria-describedby="connect-write-help"/>
									<span class="notification-copy">
										<span id="connect-write-label" class="notification-title">Allow private changes</span>
										<span id="connect-write-help" class="field-note">Manage saves, reminders, follows and reply updates; change private interest; create or discard drafts for your review.</span>
									</span>
								</label>
							}
							if p.Publish {
								// Unchecked by default: posting publicly is always a deliberate choice.
								<label>
									<input type="checkbox" name="publish" aria-labelledby="connect-publish-label" aria-describedby="connect-publish-help"/>
									<span class="notification-copy">
										<span id="connect-publish-label" class="notification-title">Allow public actions as { p.DisplayName }</span>
										<span id="connect-publish-help" class="field-note">Make interest public, recommend without a reason, withdraw recommendations, or mark contributions Helpful. Recommendations show “via { p.ClientName } ({ p.ClientHost })”. Text it writes still needs your approval before posting.</span>
									</span>
								</label>
							}
						<p class="field-note">The app can’t see your email, change your profile or preferences, or edit or remove your posts.</p>
					</fieldset>
					<p class="connect-grant"><strong>Connect with:</strong> <span class="connect-grant-read">read-only access</span><span class="connect-grant-fallback">read access plus any permissions checked above</span><span class="connect-grant-base">read access</span><span class="connect-grant-write">, private changes</span><span class="connect-grant-publish">, public actions</span>.</p>
					<div class="account-actions">
						@button.Button(button.Props{Type: button.TypeSubmit, Class: "action", Attributes: templ.Attributes{"name": "decision", "value": "allow"}}) {
							Connect
						}
						@button.Button(button.Props{Type: button.TypeSubmit, Class: "action action-secondary", Attributes: templ.Attributes{"name": "decision", "value": "deny"}}) {
							Cancel
						}
					</div>
					if p.LocalRedirect {
						<p class="field-note">Either way, you'll return to the app on this device.</p>
					} else {
						<p class="field-note">Either way, you'll return to <span class="account-connect-host">{ p.RedirectHost }</span>.</p>
					}
				</form>
				<p class="field-note">Disconnect at any time in <a href="/me/security" class="text-link">Security &amp; Apps</a>. Access expires after 30 days without a refresh.</p>
			</div>
		</main>
	}
}

// ConnectFailure explains a connection request that can't safely return to its app.
templ ConnectFailure(message string) {
	@layouts.App("profile", "App connection couldn't start") {
		@layouts.ErrorPage("App connection couldn't start", message, "Nothing was connected to your account.") {
			@button.Button(button.Props{Href: "/me", Class: "action"}) {
				Go to your profile
			}
			<a href="/" class="text-link">Discover events</a>
		}
	}
}

// Connections lists agents signed in through OAuth, each revocable.
templ Connections(p Page) {
	<section id="connected-apps" class="account-section" aria-labelledby="connected-apps-heading">
		<h2 id="connected-apps-heading">Connected apps</h2>
		<p>AI agents you connected. Each one can do only what you allowed. Text it writes, like reasons and replies, waits in <a href="/me/drafts" class="text-link">your drafts</a> until you publish it. Apps you allowed to post publicly can also act right away: make Interested choices public, recommend or withdraw recommendations without a reason, and mark posts Helpful.</p>
		<a href="/agents#connect" class="text-link">How to connect an agent</a>
		@layouts.SectionNotice(p.notice("connections"))
		if len(p.Connections) == 0 {
			<p class="field-note">You have no connected apps.</p>
		} else {
			<ul class="account-token-list">
				for _, connection := range p.Connections {
					@connectionItem(p, connection)
				}
			</ul>
			<p class="field-note">Disconnecting stops an app immediately.</p>
		}
	</section>
}

templ connectionItem(p Page, connection oauth.Grant) {
	<li>
		<div>
			<strong>{ connection.ClientName }</strong>
			<p class="field-note">
				<span class="account-connect-host">{ connection.Host() }</span> ·
				if connection.Write() {
					Can make changes
				} else if !connection.Publish() {
					Read-only
				}
				if connection.Write() && connection.Publish() {
					·
				}
				if connection.Publish() {
					<strong>Can post publicly</strong>
				}
			</p>
			<p class="field-note">Connected <time datetime={ connection.CreatedAt.Format("2006-01-02T15:04:05Z07:00") }>{ connection.CreatedAt.Format("2 Jan 2006") }</time></p>
		</div>
		<form action={ templ.URL("/me/connections/" + connection.ID + "/revoke") } method="post">
			@CSRF(p.CSRF)
			@button.Button(button.Props{Type: button.TypeSubmit, Class: "action action-secondary", Attributes: templ.Attributes{"aria-label": "Disconnect " + connection.ClientName}}) {
				Disconnect
			}
		</form>
	</li>
}
