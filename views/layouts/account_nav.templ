package layouts

import "fmt"

// AccountNavPermissions contains presentation state only. Authorization stays in handlers.
type AccountNavPermissions struct {
	ModerationEnabled bool
	Moderator bool
	// Drafts lists agent drafts; PendingDrafts is their count, shown when above zero.
	Drafts        bool
	PendingDrafts int
}

type accountDestination struct {
	Key, Href, Label string
	// Count, when above zero, is shown beside the label (pending items).
	Count int
}

type accountFamily struct {
	Label string
	Links []accountDestination
}

func accountFamilies(p AccountNavPermissions) []accountFamily {
	updates := []accountDestination{}
	if p.Drafts {
		updates = append(updates, accountDestination{"drafts", "/me/drafts", "Agent drafts", p.PendingDrafts})
	}
	updates = append(updates, accountDestination{"reminders", "/me/reminders", "On-sale reminders", 0}, accountDestination{"discussions", "/me/discussions", "Followed discussions", 0}, accountDestination{"notifications", "/me/notifications", "Reply notifications", 0})
	families := []accountFamily{
		{"Account", []accountDestination{{"profile", "/me", "Profile", 0}, {"privacy", "/me/privacy", "Privacy", 0}, {"preferences", "/me/preferences", "Preferences", 0}, {"security", "/me/security", "Security & Apps", 0}}},
		{"Your events", []accountDestination{{"radar", "/radar", "Radar", 0}, {"interests", "/me/interests", "Interests", 0}, {"follows", "/follows", "Artists & venues", 0}}},
		{"Updates", updates},
	}
	if p.ModerationEnabled {
		links := []accountDestination{{"reports", "/me/reports", "Your reports", 0}, {"outcomes", "/me/moderation", "Moderation outcomes", 0}}
		if p.Moderator {
			links = append(links, accountDestination{"queue", "/moderation", "Moderator review queue", 0})
		}
		families = append(families, accountFamily{"Safety", links})
	}
	return families
}

func (f accountFamily) contains(current string) bool {
	for _, link := range f.Links {
		if link.Key == current { return true }
	}
	return false
}

// pending totals the family's counts, so other families still show waiting work.
func (f accountFamily) pending() int {
	total := 0
	for _, link := range f.Links {
		total += link.Count
	}
	return total
}

// AccountHeader is the shared heading and navigation of every personal page.
templ AccountHeader(title, intro, current string, permissions AccountNavPermissions) {
	<header class="account-heading">
		<h1>{ title }</h1>
		if intro != "" {
			<p class="intro">{ intro }</p>
		}
	</header>
	@AccountNav(current, permissions)
}

// AccountNav shows the current family's pages as tabs and links every other
// family to its first page, so each destination is at most two steps away.
templ AccountNav(current string, permissions AccountNavPermissions) {
	<nav class="account-navigation" aria-label="Your space">
		for _, family := range accountFamilies(permissions) {
			if family.contains(current) {
				@AccountFamily(family, current)
			}
		}
		<ul class="account-families" aria-label="More in your space">
			for _, family := range accountFamilies(permissions) {
				if !family.contains(current) {
					<li>
						<a href={ templ.URL(family.Links[0].Href) }>
							{ family.Label }
							@accountCount(family.pending())
						</a>
					</li>
				}
			}
		</ul>
	</nav>
}

templ AccountFamily(family accountFamily, current string) {
	<div class="account-family" role="group" aria-label={ family.Label }>
		<div class="account-nav">
			for _, link := range family.Links {
				<a href={ templ.URL(link.Href) } aria-current={ CurrentPage(link.Key == current) }>
					{ link.Label }
					@accountCount(link.Count)
				</a>
			}
		</div>
	</div>
}

templ accountCount(count int) {
	if count > 0 {
		<span class="account-nav-count">{ fmt.Sprint(count) }<span class="sr-only">{ " pending" }</span></span>
	}
}
