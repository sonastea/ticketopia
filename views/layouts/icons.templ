package layouts

// Icon uses a shared 24px outline vocabulary based on Lucide (ISC license).
templ Icon(name string) {
	<svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
		switch name {
			case "discover":
				<circle cx="12" cy="12" r="9"></circle><path d="m16 8-2.5 5.5L8 16l2.5-5.5Z"></path>
			case "saved":
				<path d="M6 4h12v17l-6-4-6 4Z"></path>
			case "community":
				<path d="M21 11.5a8 8 0 0 1-8 8H6l-4 3 1.5-6A8 8 0 1 1 21 11.5Z"></path><path d="M7 10h10M7 14h6"></path>
			case "profile":
				<circle cx="12" cy="8" r="4"></circle><path d="M4 21v-2a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v2"></path>
			case "interests":
				<path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z"></path>
			case "location":
				<path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle>
			case "search":
				<circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"></path>
			case "calendar":
				<rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 11h18M8 15h2M14 15h2"></path>
			case "filters":
				<path d="M4 7h8M16 7h4M4 17h4M12 17h8"></path><circle cx="14" cy="7" r="2"></circle><circle cx="10" cy="17" r="2"></circle>
			case "arrow":
				<path d="M5 12h14m-5-5 5 5-5 5"></path>
			case "back":
				<path d="M19 12H5m5-5-5 5 5 5"></path>
			case "external":
				<path d="M15 3h6v6m0-6L10 14M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5"></path>
			case "chevron":
				<path d="m6 9 6 6 6-6"></path>
			case "close":
				<path d="m6 6 12 12M6 18 18 6"></path>
			case "music":
				<path d="M9 18V5l12-2v13M9 9l12-2"></path><ellipse cx="6" cy="18" rx="3" ry="3"></ellipse><ellipse cx="18" cy="16" rx="3" ry="3"></ellipse>
			case "ticket":
				<path d="M3 7V4h18v3a3 3 0 0 0 0 6v3H3v-3a3 3 0 0 0 0-6ZM15 4v2m0 4v1m0 3v2"></path>
			case "info":
				<circle cx="12" cy="12" r="9"></circle><path d="M12 11v6M12 7h.01"></path>
		}
	</svg>
}
