package layouts

import "github.com/sonastea/ticketopia/views/components/icon"

// Keep product-facing names stable while the library owns the SVG vocabulary.
templ Icon(name string) {
	@IconClass(name, "icon")
}

templ IconClass(name string, class string) {
	@icon.Icon(iconName(name))(icon.Props{Class: class, Attributes: templ.Attributes{"aria-hidden": "true", "focusable": "false"}})
}

func iconName(name string) string {
	switch name {
	case "discover":
		return "compass"
	case "saved":
		return "bookmark"
	case "community":
		return "messages-square"
	case "profile":
		return "user-round"
	case "interests":
		return "star"
	case "location":
		return "map-pin"
	case "filters":
		return "sliders-horizontal"
	case "arrow":
		return "arrow-right"
	case "back":
		return "arrow-left"
	case "external":
		return "external-link"
	case "chevron":
		return "chevron-down"
	case "chevron-up":
		return "chevron-up"
	case "close":
		return "x"
	case "customize":
		return "arrow-up-down"
	case "grip":
		return "grip-vertical"
	case "sidebar-collapse":
		return "panel-left-close"
	case "sidebar-expand":
		return "panel-left-open"
	default:
		return name
	}
}
