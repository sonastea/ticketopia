# Allow only build/validation inputs; leave local dependencies, binaries, Git,
# and docs out.
**
!go.mod
!go.sum
!package.json
!package-lock.json
!components.json
!healthcheck.go
!healthcheck_test.go
!cmd/
!cmd/**
!internal/
!internal/**
!utils/
!utils/**
!views/
!views/**

# Source files read by the local workflow and runtime-permission tests.
!Makefile
!scripts/
scripts/**
!scripts/mariadb-setup.sh
!deploy/
deploy/**
!deploy/mariadb/
deploy/mariadb/**
!deploy/mariadb/runtime-check.sql
!deploy/mariadb/runtime-grants.sql
!deploy/mariadb/operator/
deploy/mariadb/operator/**
!deploy/mariadb/operator/database.yaml

# Never send local configuration or data, even from an included directory.
**/.env*
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
